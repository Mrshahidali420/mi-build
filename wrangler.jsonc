{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "manhwaindex",
  "compatibility_date": "2026-09-01",
  // Zone routes, not custom domains: since 7 Oct 2026 custom domains were
  // handed 188.114.96.0/20 IPs that some networks (Pakistan) cannot reach.
  // The apex and www need proxied AAAA 100:: records in the zone's DNS.
  "routes": [
    {
      "pattern": "manhwaindex.com/*",
      "zone_name": "manhwaindex.com"
    },
    {
      "pattern": "www.manhwaindex.com/*",
      "zone_name": "manhwaindex.com"
    }
  ],
  "assets": {
    "directory": "./dist",
    // Must stay "none". With "404-page" the asset server answers every page
    // navigation itself, and a title page that has no static file gets 404.html
    // without the Worker ever running. The Worker owns the misses.
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Our own visitor counter. A small script on every page queues rows and
  // posts them in one request per visit, and /my-admin reads them back. Some
  // robots do run scripts, so nothing is written without a Turnstile pass
  // (see src/worker.js). The limit that bites first is D1's 100,000 written
  // rows a day: each event costs about 3 (the row, one index, the id
  // counter). See db/schema.sql.
  "d1_databases": [
    {
      "binding": "ANALYTICS",
      "database_name": "manhwaindex-analytics",
      "database_id": "a31cde34-a594-4430-b415-79869e4f4435"
    }
  ],
  // Ten minutes after midnight UTC the Worker adds up the day that just ended
  // and throws away raw rows older than 30 days. See src/lib/rollup.js. Cron
  // runs are free on the Workers free plan: one run is one request.
  "triggers": { "crons": ["10 0 * * *"] },
  "main": "src/worker.js"
}
