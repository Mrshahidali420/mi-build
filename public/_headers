# Build files carry a content hash in their name, so a changed file always gets
# a new URL. Without this rule they went out with max-age=0 and every page view
# asked again for the same scripts and fonts.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

# Search slices. The catalog is rebuilt once a day, so an hour of browser
# cache costs nothing and makes the second search on a visit instant.
/search/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# "My list" rows and the "For you" pool (scripts/make-shards.mjs). Rebuilt
# once a day like the search slices, so the same hour of browser cache.
/d/l/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/d/feed.v1.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
