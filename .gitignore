node_modules/
dist/
.astro/
.wrangler/
ingest.log

# Page dumps from the AniList pull. 60 MB, and the pull rebuilds them.
data/raw/
data/raw-v1/
.impeccable/
data/redirects.json

# Built by scripts/make-shards.mjs on every build, like the redirects.
public/d/
data/shards.json
data/site-stats.json
data/answer-urls.json

# The catalog. Too big for git: at full size comics.json alone is 141 MB and
# GitHub refuses any file over 100 MB. These live in the GitHub Actions cache
# instead; see .github/workflows/backfill.yml. Your local copies stay put.
data/comics.json
data/anime.json
data/characters.json
data/characters-walk.json
data/novels-walk.json
data/seen.json

# Written by scripts/indexnow.mjs. Lives in the Actions cache, not in git.
data/indexnow-sent.json

# The manifest of the last deployed site. Lives in the Actions cache, not in git.
data/live-manifest.json

# The slug registry: every page's frozen address. Lives in the Actions cache
# and in R2 (scripts/catalog-snapshot.mjs), like the catalog it describes.
# The marker is written only when a lost registry had to be worked out again.
data/slug-registry.json
data/slug-registry.recovered

# Half-written files from an atomic write or an R2 pull that was killed.
data/*.tmp
data/*.r2

# Opening and ending songs (scripts/sync-animethemes.mjs). Lives in the Actions
# cache (animethemes-*) and in R2, like the walk files.
data/themes.json

# Episode air dates, read from the sister ingest's R2 bucket before each build
# (scripts/pull-airing.mjs). Never cached: a missing file only hides the lists.
data/airing.json

# WhereAnime's live pages, read from R2 before each build
# (scripts/pull-where-links.mjs). Never cached: a missing file only hides the links.
data/where-links.json

# Local secrets for `wrangler dev`. Never committed.
.dev.vars

# Opens and clicks out per title page over 30 days (scripts/plan-home.mjs),
# for the "read something like it" picks. Lives in its own Actions cache entry
# (handoff-*); a missing file only ranks the picks by popularity.
data/handoff.json
