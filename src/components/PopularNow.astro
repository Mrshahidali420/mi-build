---
/**
 * "Popular characters right now": twenty plain links from the home page.
 *
 * Search Console shows a few hundred pages sitting just off Google's first
 * page (position 8 to 20) with no page of their own story ranking well enough
 * to link to them. Anos Voldigoad had 2,390 impressions at 10.6 in September
 * 2026 and nothing to push him up. The home page is the strongest page on the
 * site, so it links the best of them, in the words people search: the name,
 * and the story in small text.
 *
 * data/home-boost.json is written by scripts/build-boost-links.mjs with the
 * monthly refresh (docs/boost-links.md), and only for pages that answered 200
 * on the live site that day. Imported at build time: the home page is a file,
 * so this costs the Worker nothing.
 *
 * It sits well below the fold. The faces are small (AniList's 100-pixel copy),
 * lazy, and sized, so the page neither waits for them nor jumps.
 */
import data from '../../data/home-boost.json'

const items = (data.items || []).filter((item) => item && item.path && item.name)
---

{
  items.length > 0 && (
    <section class="section" data-phase="night" data-home-section="chars" aria-labelledby="popular-now">
      <div class="section__head">
        <h2 id="popular-now">Popular characters right now</h2>
        <p>The characters people are looking up this month.</p>
      </div>
      <ul class="popnow">
        {items.map((item) => (
          <li>
            <a href={item.path}>
              {item.image ? (
                <img src={item.image} alt="" width="44" height="66" loading="lazy" decoding="async" />
              ) : (
                <i class="popnow__blank" aria-hidden="true" />
              )}
              <span>
                <b>{item.name}</b>
                {item.story && <em>{item.story}</em>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style is:global>
  /* Global on purpose, like WatchList.astro: no per-element scope stamp. The
     tile follows "Anime airing this week" just above it: a thin edge, a small
     picture, the name in white and one quiet line under it. */
  .popnow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15.5rem, 1fr));
    gap: 0.5rem;
  }
  .popnow a {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    min-width: 0;
    height: 100%;
    padding: 0.45rem 0.7rem 0.45rem 0.45rem;
    border: 1px solid var(--cobalt-line);
    text-decoration: none;
    transition: border-color 140ms var(--ease-dawn);
  }
  .popnow a:hover,
  .popnow a:focus-visible {
    border-color: var(--rose);
  }
  .popnow img,
  .popnow__blank {
    width: 44px;
    height: 66px;
    object-fit: cover;
    flex: none;
    border-radius: 4px;
    background: var(--night-raised);
  }
  .popnow span {
    min-width: 0;
  }
  .popnow b {
    display: block;
    color: var(--day);
    font-weight: 600;
    font-size: 0.9rem;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }
  .popnow em {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    margin-top: 0.15rem;
    font-style: normal;
    font-size: 0.78rem;
    line-height: 1.3;
    color: var(--dawn-faint);
  }
  /* A phone gets three rows that scroll sideways inside the block, so twenty
     names cost about one screen of height, not four. */
  @media (max-width: 640px) {
    .popnow {
      grid-template-columns: none;
      grid-template-rows: repeat(3, auto);
      grid-auto-flow: column;
      grid-auto-columns: 80%;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x proximity;
      padding-bottom: 0.5rem;
    }
    .popnow li {
      scroll-snap-align: start;
    }
  }
</style>
