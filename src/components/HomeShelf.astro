---
/**
 * One self-updating homepage shelf (Rising this week, Readers are saving, New
 * and noticed, Most opened this month), drawn like the Trending shelves.
 *
 * data-home-section and data-home-ids are read by the small script in
 * src/pages/index.astro: which shelf a cover sits in, and which title is in
 * which slot, so a click can be counted as "title X from shelf Y, slot N"
 * without putting anything extra on every cover.
 */
import CoverGrid from './CoverGrid.astro'

// counted={false}: a shelf the homepage counter has no key for (see
// src/lib/home-sections.js) is drawn the same way but not reported.
const { shelf, counted = true } = Astro.props
---

<section
  class="section"
  data-phase="night"
  data-home-section={counted ? shelf.key : undefined}
  data-home-ids={counted ? shelf.items.map((item) => item.id).join(',') : undefined}
  aria-labelledby={`home-${shelf.key}-h`}
>
  <div class="section__head section__head--row">
    <div>
      <h2 id={`home-${shelf.key}-h`}>{shelf.title}</h2>
      <p>{shelf.why}</p>
    </div>
    {shelf.href && <a class="section__more" href={shelf.href}>All of it →</a>}
  </div>
  <div class="shelf-wrap">
    <button type="button" class="shelf-arrow shelf-arrow--left" aria-label={`Scroll ${shelf.title} left`}>
      ‹
    </button>
    <CoverGrid items={shelf.items} shelf />
    <button type="button" class="shelf-arrow shelf-arrow--right" aria-label={`Scroll ${shelf.title} right`}>
      ›
    </button>
  </div>
  <slot />
</section>
