---
/**
 * One character on the wall: a face, a name, and two doors under it.
 *
 * "Details" opens the profile. "Merch" opens the best shop we have for them:
 *   - the character's own buy page, when its gate in src/lib/gates.mjs says
 *     that page exists. The buy page answers 404 when the gate says no, so the
 *     wall must apply the same gate or it sends readers to a dead end.
 *   - otherwise the Amazon box on the character's profile (#buy). Every
 *     profile carries one, with the story's books and, for a known face, their
 *     own figures. So every card gets a Merch door, and none of them opens a
 *     thin page or leaves the site straight from the wall.
 * A noindexed buy page (all of them, unless Google already shows it: see
 * src/lib/thin-pages.mjs) is not linked from the wall; its card opens the
 * profile's box instead. The wall is prerendered, so data/index-keep.json is
 * read from disk at build time and never reaches the Worker.
 */
import { kindOfAppearance } from '../lib/catalog.js'
import { characterBuyLinkable } from '../lib/thin-pages.mjs'
import { indexKeepOnce } from '../lib/index-keep.js'
import { displayName } from '../lib/names.mjs'

const { person, eager = false } = Astro.props
const buyPage = characterBuyLinkable(person, indexKeepOnce())
// characterShopLinks gives nothing for a name under two letters, so the
// profile would have no box to jump to.
const merch = buyPage || String(person.name || '').trim().length >= 2
const merchHref = buyPage ? `/character/${person.slug}/buy` : `/character/${person.slug}#buy`
// The same name the profile page leads with, so the card and the page agree.
const { primary: name } = displayName(person)
---

<li>
  <a class="tile__face" href={`/character/${person.slug}`}>
    <img
      src={person.image}
      alt={`${name} portrait`}
      width="220"
      height="293"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
    <b>{name}</b>
    <span>{kindOfAppearance(person.appearsIn[0])}</span>
  </a>
  <div class="tile__doors">
    <a href={`/character/${person.slug}`} aria-label={`${name} details`}>Details</a>
    {merch && (
      <a class="tile__merch" href={merchHref} aria-label={buyPage ? `Buy ${name} figures and merch` : `Shop ${name} merch and books`}>
        <svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
          <path d="M3 6h18" />
          <path d="M16 10a4 4 0 0 1-8 0" />
        </svg>
        Merch
      </a>
    )}
  </div>
</li>
