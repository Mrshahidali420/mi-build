---
/**
 * The end of the page: what AniList readers picked next (a human vote, so it
 * comes first), then the closest titles by genre, then the "like" page when
 * it exists. Same blocks and words as before, grouped at the bottom.
 *
 * Last comes the quiet shelf: titles close to this one that few pages link
 * to yet (src/lib/link-spread.mjs), so the long tail of the catalog can be
 * reached from a page a reader already found.
 *
 * props: title, isComic, word, recs, similar, similarBase, likePage, lessKnown
 */
import CoverGrid from '../CoverGrid.astro'

const { title, isComic, word, recs = [], similar = [], similarBase, likePage, lessKnown = [] } = Astro.props
// What the quiet picks have in common with this title, said once for the shelf.
const quietShared = [...new Set(lessKnown.flatMap((p) => p.shared || []))].slice(0, 3)
const quietWhy =
  quietShared.length > 1
    ? `${quietShared.slice(0, -1).join(', ')} and ${quietShared[quietShared.length - 1]}`
    : quietShared[0] || ''
const open = similar.filter((p) => ((p.kind === 'anime' ? p.watchLinks : p.readLinks) || []).length > 0).length
---

{
  recs.length > 0 && (
    <section class="answer dp-more-like" id="more">
      <div class="answer__head">
        <h2>Readers of {title} picked these next</h2>
        <p>Voted for by AniList readers who finished this one. Open any of them to see where to read or watch it legally.</p>
      </div>
      <CoverGrid items={recs} badges />
    </section>
  )
}

{
  similar.length > 0 && (
    <section class="answer dp-more-like" id={recs.length ? undefined : 'more'}>
      <div class="answer__head">
        <h2>You may also like</h2>
        <p>
          {open > 0
            ? `${open} of these ${open === 1 ? 'has' : 'have'} an official place to ${isComic ? 'read' : 'watch'} right now. Closest by genre, most-read first.`
            : `Closest ${word} by genre, most-read first.`}
        </p>
      </div>
      <CoverGrid items={similar} base={similarBase} badges />
      {likePage && (
        <a class="crosslink dp-more-like__page" href={likePage.href}>
          <div>
            <span class="crosslink__lead">{likePage.lead}</span>
            <span class="crosslink__title">{likePage.title}</span>
            <span class="crosslink__lead">{likePage.note}</span>
          </div>
        </a>
      )}
    </section>
  )
}

{
  lessKnown.length > 0 && (
    <section class="answer dp-more-like">
      <div class="answer__head">
        <h2>Less known {word} like {title}</h2>
        <p>
          {quietWhy ? `Smaller titles that share ${quietWhy} with this one.` : 'Smaller titles by the same author or studio.'} Fewer
          readers have found them yet.
        </p>
      </div>
      <CoverGrid items={lessKnown} badges />
    </section>
  )
}

{
  similar.length === 0 && likePage && (
    <a class="crosslink" href={likePage.href}>
      <div>
        <span class="crosslink__lead">{likePage.lead}</span>
        <span class="crosslink__title">{likePage.title}</span>
        <span class="crosslink__lead">{likePage.note}</span>
      </div>
    </a>
  )
}
