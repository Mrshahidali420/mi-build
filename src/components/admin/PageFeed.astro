---
/**
 * The newest pages opened, one line each: a dot (rose = the visit started
 * here), the time, the page name cut with "…", and a small line with the
 * page's kind, where the reader came from, the country, the page number
 * inside the visit and the device.
 *
 * The kind opens the second line, not the first: a long title already fills
 * the first line up to its own "…", and a word tacked on after it would be
 * pushed off a 390 px phone before the reader ever sees it.
 *
 * rows: [{ ts, href, name, section, from, country, step, device }]
 */
import { adminClock, countryName } from '../../lib/admin.js'
import { flagOf } from '../../lib/admin-chart.js'

const { rows = [], empty = 'Nothing yet.' } = Astro.props
const lines = rows.map((row) => ({
  ...row,
  where: row.country ? `${flagOf(row.country) ? `${flagOf(row.country)} ` : ''}${countryName(row.country)}` : '',
}))
---

{lines.length === 0 && <p class="empty">{empty}</p>}
{lines.length > 0 && (
  <ul class="feed no-icon">
    {lines.map((row) => (
      <li>
        <span
          class={`dot ${(row.step || 1) > 1 ? 'bg-dim' : 'bg-accent'}`}
          title={(row.step || 1) > 1 ? 'Moved on from another page' : 'The visit started here'}
        ></span>
        <time datetime={new Date(row.ts).toISOString()}>{adminClock(row.ts).replace(' PKT', '')}</time>
        <span class="what">
          <span class="line1" title={row.name}>
            <a href={row.href}>{row.name}</a>
          </span>
          <span class="meta">
            {row.section !== row.name && `${row.section} · `}
            <span class="src">{row.from}</span>
            {row.where && ` · ${row.where}`}
            {` · page ${row.step || 1}`}
            {row.device && ` · ${row.device}`}
          </span>
        </span>
        <span></span>
      </li>
    ))}
  </ul>
)}
