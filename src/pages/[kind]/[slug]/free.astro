---
/**
 * "Where to read X free and legal."
 *
 * The question a pirate site normally wins. We answer it straight: yes and
 * where, or no and what it costs instead. Every word is written at request
 * time from the same record the title page uses, so this page can never
 * disagree with it. See src/lib/answers.mjs.
 */
import Base from '../../../layouts/Base.astro'
import AlsoLookFor from '../../../components/AlsoLookFor.astro'
import Platforms from '../../../components/Platforms.astro'
import { loadTitle, envOf, countryOf, notFound, unavailable } from '../../../lib/runtime.js'
import { sectionOf, SECTIONS } from '../../../lib/section.mjs'
import { verbOf, wordOf, faqJsonld, listWords } from '../../../lib/answers.mjs'
import { freeAnswer } from '../../../lib/free-answer.mjs'
import { titleSummary } from '../../../lib/title-summary.mjs'
import { shopLinks } from '../../../lib/shop-links.js'
import { booksKnown } from '../../../lib/picks.js'
import { hasFreePage, hasLikePage, hasBuyPage } from '../../../lib/gates.mjs'
import BuyBox from '../../../components/BuyBox.astro'
import { genreSlug } from '../../../lib/format.js'

const KINDS = new Set(SECTIONS)

const { kind, slug } = Astro.params
if (!KINDS.has(kind)) return notFound(Astro)

let item
try {
  item = await loadTitle(envOf(Astro), kind, slug)
} catch (e) {
  // The shard did not read: 503, not 404. The page still exists.
  return unavailable(Astro, e)
}
if (!item) return notFound(Astro)

const isComic = item.kind !== 'anime'
if (sectionOf(item) !== kind) return notFound(Astro)
// No platform gives any of it away, so there is no free answer to give. The
// same gate keeps the page out of the sitemap.
if (!hasFreePage(item)) return notFound(Astro)

const verb = verbOf(kind)
const word = wordOf(kind)
const answer = freeAnswer(item, kind)
const home = `/${kind}/${item.slug}`
const paidRows = [...answer.paid, ...answer.unknown]

// This page outranks the title page for the question people actually type, so
// it is where most readers land -- and until now it was the only title page
// with no way to buy anything. A reader who just learned a story is worth
// reading is the readiest buyer we ever get, and we were sending them away.
const buys = shopLinks(item, countryOf(Astro), { books: booksKnown(item) })

// The synopsis, the facts table and the cast live on the title page. This
// page says what the title is in two lines and links there (owner decision,
// Step 6 of tasks/phase3-plan.md), so it no longer repeats them word for word.
const genres = (item.genres || []).slice(0, 4)
const summary = titleSummary(item, kind)

const kindLabel = word.charAt(0).toUpperCase() + word.slice(1)
// One question, answered with this title's own platforms; how much each gives
// away is the paragraph above it. The second one ("Is it legal...?") had the
// same answer on every free page, so it went.
const faq = answer.free.length
  ? [{ q: `Is ${item.title} free to ${verb}?`, a: `In part, on ${listWords(answer.free.map((r) => r.link.site))}.` }]
  : []

const jsonld = [
  {
    '@type': 'WebPage',
    '@id': `https://manhwaindex.com${home}/free#page`,
    url: `https://manhwaindex.com${home}/free`,
    name: answer.heading,
    inLanguage: 'en',
    dateModified: new Date().toISOString().slice(0, 10),
    about: { '@id': `https://manhwaindex.com${home}#item` },
  },
  ...(faq.length ? [faqJsonld(faq)] : []),
]
---

<Base
  title={answer.pageTitle}
  description={answer.description}
  image={item.cover}
  jsonld={jsonld}
  crumbs={[{ name: kindLabel, href: `/${kind}` }, { name: item.title, href: home }, { name: 'Free' }]}
>
  <div class="shell title-page">
    <div class="cover-rail">
      <div class="cover-wrap">
        <img class="cover" src={item.cover} alt={`Cover of ${item.title}`} width="460" height="651" loading="eager" fetchpriority="high" decoding="async" />
      </div>
    </div>

    <header class="title-head">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <a href={`/${kind}`}>{kindLabel}</a>
        <a href={home}>{item.title}</a>
      </nav>
      <h1>{answer.heading}</h1>
      <ul class="title-head__meta">
        <li>{answer.status}</li>
        {item.startYear && <li>{item.startYear}</li>}
        {isComic && item.chapters && <li>{item.chapters} chapters</li>}
        {!isComic && item.episodes && <li>{item.episodes} episodes</li>}
        {genres.map((genre) => (
          <li class="title-head__genre">
            <a href={`/genre/${genreSlug(genre)}`}>{genre}</a>
          </li>
        ))}
      </ul>
    </header>

    <div class="title-body">
      <p class="title-answer">{answer.lede}</p>

      {/* The answer comes first, the door to the full page comes straight after.
          Most readers arrive here from search and never see the title page, so
          the way back to it has to be the loudest thing under the answer. */}
      <a class="jump" href={home}>
        <img src={item.cover} alt="" width="46" height="65" loading="lazy" decoding="async" />
        <span class="jump__text">
          <span class="jump__lead">Full page</span>
          <span class="jump__title">{item.title}</span>
          <span class="jump__lead">Every platform, the facts, the cast and what to read next</span>
        </span>
        <svg class="jump__arrow" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>

      {
        answer.free.length > 0 && (
          <Platforms
            heading={`Free and official`}
            links={answer.free.map((r) => r.link)}
            count={`${answer.free.length} ${answer.free.length === 1 ? 'platform gives' : 'platforms give'} part of it away`}
            verb={verb}
          >
            <Fragment slot="empty">
              <p>Nothing free here.</p>
            </Fragment>
          </Platforms>
        )
      }

      {
        answer.paragraphs.map((block) => (
          <section class="answer">
            <div class="answer__head">
              <h2>{block.heading}</h2>
            </div>
            <p class="overview">{block.text}</p>
          </section>
        ))
      }

      {
        paidRows.length > 0 && (
          <Platforms
            heading={answer.free.length > 0 ? 'Paid, and worth it for the newest parts' : 'The official platforms'}
            links={paidRows.map((r) => r.link)}
            count={`${paidRows.length} official ${paidRows.length === 1 ? 'place' : 'places'}`}
            verb={verb}
          >
            <Fragment slot="empty">
              <p>None listed.</p>
            </Fragment>
          </Platforms>
        )
      }

      {
        buys.length > 0 && (
          <BuyBox
            heading={`Own ${item.title}`}
            sub={
              answer.free.length > 0
                ? 'Free is for reading it. This is for keeping it.'
                : 'No platform gives it away, so here is where to buy a copy.'
            }
            rows={buys}
          />
        )
      }

      {
        summary.length > 0 && (
          <section class="answer">
            <div class="answer__head">
              <h2>About {item.title}</h2>
            </div>
            {summary.map((line) => <p class="overview">{line}</p>)}
            <p class="overview"><a href={home}>The synopsis, the facts and the cast are on the title page</a>.</p>
          </section>
        )
      }

      <AlsoLookFor path={Astro.url.pathname} frame="answer" />

      {faq.length > 0 && (
        <section class="answer">
          <div class="answer__head">
            <h2>Common questions</h2>
          </div>
          <dl class="qa">
            {
              faq.map((row) => (
                <div>
                  <dt>{row.q}</dt>
                  <dd>{row.a}</dd>
                </div>
              ))
            }
          </dl>
        </section>
      )}

      {
        /* Only when the page exists. An empty "similar" page is a worse
           click than no click, so it answers 404. */
        hasLikePage(item) && (
          <a class="crosslink" href={`${home}/like`}>
            <div>
              <span class="crosslink__lead">Finished it already?</span>
              <span class="crosslink__title">Stories like {item.title}</span>
              <span class="crosslink__lead">Picks you can {verb} legally too</span>
            </div>
          </a>
        )
      }

      {
        /* A reader who just learned a story is worth reading is the readiest
           buyer we ever get. The buy page only exists for stories people
           search for, so the link is gated the same way. */
        hasBuyPage(item) && (
          <a class="crosslink" href={`${home}/buy`}>
            <div>
              <span class="crosslink__lead">Want to own it?</span>
              <span class="crosslink__title">Where to buy {item.title}</span>
              <span class="crosslink__lead">Printed volumes, figures and posters, in your own store</span>
            </div>
          </a>
        )
      }

      <a class="crosslink" href={home}>
        <div>
          <span class="crosslink__lead">Everything we know about it</span>
          <span class="crosslink__title">{item.title}</span>
          <span class="crosslink__lead">
            Full platform table, the facts, the cast and the family tree
          </span>
        </div>
      </a>
    </div>
  </div>
</Base>
