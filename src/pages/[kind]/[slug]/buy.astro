---
/**
 * "Where to buy X."
 *
 * A different question from "where can I read it". A reader who types "buy"
 * has already decided; they only want the shop. So the shop rows sit at the
 * top of this page, not at the bottom.
 *
 * Only stories people actually search for get this page. See BUY_POPULARITY
 * in src/lib/buy.mjs for why.
 */
import Base from '../../../layouts/Base.astro'
import AlsoLookFor from '../../../components/AlsoLookFor.astro'
import BuyBox from '../../../components/BuyBox.astro'
import TopPicks from '../../../components/TopPicks.astro'
import { picksForTitle, picksShowFor, booksKnown } from '../../../lib/picks.js'
import { loadTitle, envOf, countryOf, notFound, unavailable } from '../../../lib/runtime.js'
import { sectionOf, SECTIONS } from '../../../lib/section.mjs'
import { faqJsonld } from '../../../lib/answers.mjs'
import { shopLinks } from '../../../lib/shop-links.js'
import { titleBuyCopy } from '../../../lib/buy-copy.js'
import { buyAnswer, BUY_POPULARITY } from '../../../lib/buy.mjs'
import { hasBuyPage, hasFreePage } from '../../../lib/gates.mjs'
import { statusWord, charactersOf, genreSlug } from '../../../lib/format.js'

const KINDS = new Set(SECTIONS)

const { kind, slug } = Astro.params
if (!KINDS.has(kind)) return notFound(Astro)

let item
try {
  item = await loadTitle(envOf(Astro), kind, slug)
} catch (e) {
  // The shard did not read: 503, not 404. The page still exists.
  return unavailable(Astro, e)
}
if (!item) return notFound(Astro)

const isComic = item.kind !== 'anime'
if (sectionOf(item) !== kind) return notFound(Astro)

// The gate. A story nobody looks for was almost certainly never printed in
// English, so every shop link here would open an empty shelf.
if ((item.popularity || 0) < BUY_POPULARITY) return notFound(Astro)

const answer = buyAnswer(item, kind)
const buys = shopLinks(item, countryOf(Astro), { books: booksKnown(item) })
if (buys.length === 0) return notFound(Astro)
// Hand-picked products, for readers on amazon.com only (see src/lib/picks.js).
const picked = picksShowFor(countryOf(Astro)) ? picksForTitle(item) : null
// The same reason line as the title page, so the two never disagree.
const buyCopy = titleBuyCopy(item, {
  books: booksKnown(item),
  printKnown: Boolean(picked?.picks?.some((pick) => pick.t === 'book')),
})
// The sitemap's own gate, so the two can never disagree about this page.
if (!hasBuyPage(item)) return notFound(Astro)

const home = `/${kind}/${item.slug}`
const word = answer.word
const verb = answer.verb
const kindLabel = word.charAt(0).toUpperCase() + word.slice(1)
const genres = (item.genres || []).slice(0, 4)
const cast = charactersOf(item).slice(0, 12)

const facts = [
  ['Status', statusWord(item.status)],
  ...(isComic && item.volumes ? [['Volumes (original release)', item.volumes]] : []),
  isComic
    ? ['Chapters', item.chapters ?? 'Not counted']
    : ['Episodes', item.episodes ?? 'Not counted'],
  ...(!isComic && item.studios?.[0] ? [['Studio', item.studios[0]]] : []),
  ...(item.startYear ? [['First released', item.startYear]] : []),
  ['Format', word],
  ...(item.authors?.length ? [['Author', item.authors.map((a) => a.name).join(', ')]] : []),
]

const jsonld = [
  {
    '@type': 'WebPage',
    '@id': `https://manhwaindex.com${home}/buy#page`,
    url: `https://manhwaindex.com${home}/buy`,
    name: answer.heading,
    inLanguage: 'en',
    dateModified: new Date().toISOString().slice(0, 10),
    about: { '@id': `https://manhwaindex.com${home}#item` },
    alternateName: [item.titleNative, ...answer.names].filter(Boolean),
  },
  faqJsonld(answer.faq),
]
---

<Base
  title={answer.pageTitle}
  description={answer.description}
  image={item.cover}
  jsonld={jsonld}
  crumbs={[{ name: kindLabel, href: `/${kind}` }, { name: item.title, href: home }, { name: 'Buy' }]}
>
  <div class="shell title-page">
    <div class="cover-rail">
      <div class="cover-wrap">
        <img class="cover" src={item.cover} alt={`Cover of ${item.title}`} width="460" height="651" loading="eager" fetchpriority="high" decoding="async" />
      </div>
    </div>

    <header class="title-head">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <a href={`/${kind}`}>{kindLabel}</a>
        <a href={home}>{item.title}</a>
      </nav>
      <h1>{answer.heading}</h1>
      {item.titleNative && <p class="title-head__native">{item.titleNative}</p>}
      {answer.names.length > 0 && (
        <p class="title-head__aka">Also sold as {answer.names.join(' · ')}</p>
      )}
      <ul class="title-head__meta">
        <li>{statusWord(item.status)}</li>
        {item.startYear && <li>{item.startYear}</li>}
        {isComic && item.volumes && <li>{item.volumes} volumes</li>}
        {!isComic && item.episodes && <li>{item.episodes} episodes</li>}
        {genres.map((genre) => (
          <li class="title-head__genre">
            <a href={`/genre/${genreSlug(genre)}`}>{genre}</a>
          </li>
        ))}
      </ul>
    </header>

    <div class="title-body">
      <p class="title-answer">{answer.lede}</p>

      {/* The reader came here to buy. Real hand-picked products go first, as
          on the title page; the store searches follow. Only the first box
          says the support line. */}
      {picked && (
        <TopPicks
          heading={`Top picks for ${picked.from || item.title}`}
          sub={picked.byHand ? 'Real products on Amazon, picked by hand.' : 'Real products on Amazon, matched from publisher records.'}
          byHand={picked.byHand}
          picks={picked.picks}
          max={8}
        />
      )}

      <BuyBox heading={`Own ${item.title}`} sub={buyCopy.sub} rows={buys} support={!picked} />

      {
        answer.paragraphs.map((block) => (
          <section class="answer">
            <div class="answer__head">
              <h2>{block.heading}</h2>
            </div>
            <p class="overview">{block.text}</p>
          </section>
        ))
      }

      <section class="answer">
        <div class="answer__head">
          <h2>The facts</h2>
        </div>
        <dl class="facts">
          {
            facts.map(([label, value]) => (
              <div>
                <dt>{label}</dt>
                <dd>{value}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      {
        cast.length > 0 && (
          <section class="answer">
            <div class="answer__head">
              <h2>Merch of the cast</h2>
              <p>Tap a face for the figures, prints and shirts made of that character.</p>
            </div>
            <ul class="people">
              {cast.map((person) => (
                <li>
                  <a href={`/character/${person.slug}`}>
                    <img src={person.image} alt={`${person.name} portrait`} width="220" height="293" loading="lazy" decoding="async" />
                    <b>{person.name}</b>
                    <span>{person.role === 'MAIN' ? 'Main' : 'Supporting'}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <AlsoLookFor path={Astro.url.pathname} frame="answer" />

      <section class="answer">
        <div class="answer__head">
          <h2>Common questions</h2>
        </div>
        <dl class="qa">
          {
            answer.faq.map((row) => (
              <div>
                <dt>{row.q}</dt>
                <dd>{row.a}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      {
        /* Only when the free page exists. With no free platform it answers 404. */
        hasFreePage(item) && (
          <a class="crosslink" href={`${home}/free`}>
            <div>
              <span class="crosslink__lead">Not ready to pay yet?</span>
              <span class="crosslink__title">Where to {verb} {item.title} free</span>
              <span class="crosslink__lead">Every official platform that gives part of it away</span>
            </div>
          </a>
        )
      }

      <a class="crosslink" href={home}>
        <div>
          <span class="crosslink__lead">Everything we know about it</span>
          <span class="crosslink__title">{item.title}</span>
          <span class="crosslink__lead">
            Full platform table, the facts, the cast and the family tree
          </span>
        </div>
      </a>

    </div>
  </div>
</Base>
