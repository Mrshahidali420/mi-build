---
import Base from '../../layouts/Base.astro'
import AlsoLookFor from '../../components/AlsoLookFor.astro'
import FeaturedIn from '../../components/FeaturedIn.astro'
import '../../styles/detail.css'
import DetailHero from '../../components/detail/DetailHero.astro'
import JumpNav from '../../components/detail/JumpNav.astro'
import DetailRail from '../../components/detail/DetailRail.astro'
import WhereTo from '../../components/detail/WhereTo.astro'
import About from '../../components/detail/About.astro'
import Cast from '../../components/detail/Cast.astro'
import Related from '../../components/detail/Related.astro'
import Shop from '../../components/detail/Shop.astro'
import Details from '../../components/detail/Details.astro'
import Faq from '../../components/detail/Faq.astro'
import MoreLike from '../../components/detail/MoreLike.astro'
import {
  formatWord,
  statusWord,
  truncate,
  charactersOf,
  platform,
  enrichOf,
} from '../../lib/format.js'
import { loadTitle, envOf, countryOf, notFound, unavailable } from '../../lib/runtime.js'
import { titleFaq, faqJsonld, freeSplit } from '../../lib/answers.mjs'
import { coverage, adaptationAnswer, readingOrder, upcoming } from '../../lib/computed.mjs'
import { shopLinks } from '../../lib/shop-links.js'
import { trialFor } from '../../lib/shop-shelf.js'
import { titleBuyCopy } from '../../lib/buy-copy.js'
import { hasFreePage, hasLikePage, hasCastPage, hasBuyPage } from '../../lib/gates.mjs'
import { picksForTitle, picksShowFor, booksKnown } from '../../lib/picks.js'
import Themes from '../../components/Themes.astro'
import EpisodeList from '../../components/EpisodeList.astro'
import { dubOf } from '../../lib/dub.mjs'
import { titleAnswer, aboutParagraphs, ledeOf } from '../../lib/title-answer.mjs'
import { startedByClock } from '../../lib/started.mjs'
import { whereAnimeUrl } from '../../lib/where-links.mjs'
import { needsAlike } from '../../lib/alike.mjs'
import { checkedISO, checkedLong } from '../../lib/checked.js'
import { sectionOf, SECTIONS } from '../../lib/section.mjs'
import { seasonLabel, seasonPath, seasonWhen } from '../../lib/season-core.mjs'
import Ratings from '../../components/Ratings.astro'
import { aggregateJsonld, reviewsJsonld } from '../../lib/reviews.mjs'
import {
  readTitleReviews,
  EDGE_HEADER,
  DEGRADED_EDGE_SECONDS,
} from '../../lib/reviews-read.js'

// This page is rendered by the Worker when someone asks for it. It is not
// built as a file, so the number of titles has no ceiling.
const KINDS = new Set(SECTIONS)

const { kind, slug } = Astro.params
if (!KINDS.has(kind)) return notFound(Astro)

let item
try {
  item = await loadTitle(envOf(Astro), kind, slug)
} catch (e) {
  // The shard did not read: 503, not 404. The page still exists.
  return unavailable(Astro, e)
}
if (!item) return notFound(Astro)
// AniList can keep "not yet released" for days after episode 1 airs; once that
// episode's own time has passed, the page says the show is out.
item = startedByClock(item, Math.floor(Date.now() / 1000))

const isComic = item.kind !== 'anime'
// The slug alone is not proof: a manhwa must not answer on /manga/.
if (sectionOf(item) !== kind) return notFound(Astro)

// Our own readers' stars and the reviews the owner approved, read live from
// D1 so an approval shows without a build (src/lib/reviews-read.js). Started
// here and awaited below, so the read overlaps the work in between. It never
// throws and gives up after a fraction of a second; then the block shows no
// numbers, and the Worker keeps this copy for a minute instead of ten.
const voicesRead = readTitleReviews(envOf(Astro)?.ANALYTICS, item.id)

const word = isComic ? formatWord(item) : 'anime'
const links = isComic ? item.readLinks : item.watchLinks
// The table merges the language editions of a platform into one row, so the
// count above it has to be counted the same way.
const siteCount = new Set((links || []).map((l) => l.site)).size

const related = isComic ? item.animeInIndex : item.comicInIndex

// The page title is written the way people actually type the search.
const pageTitle = isComic
  ? `Read ${item.title} Online — Official ${word} Sites & Apps`
  : `Watch ${item.title} Online — Official Streaming Sites`

// Airing helper: turn the next-episode timestamp into a readable date.
// This page is rendered by the Worker on request, so "now" is the reader's
// own moment. An episode whose time has already passed is dropped: the data
// is only as fresh as the last daily build, and a stale countdown is a lie.
const nextEp =
  item.nextEpisode && item.nextEpisode.at * 1000 > Date.now()
    ? new Date(item.nextEpisode.at * 1000).toLocaleDateString('en-US', {
        weekday: 'long',
        month: 'long',
        day: 'numeric',
        timeZone: 'UTC',
      })
    : null

// One title can have several language editions on the same platform, so
// the same name must not be listed twice.
const platformNames = [...new Set(links.map((l) => l.site))]

// How many platforms give something away. Said once, in the head of the
// Watch / Read section ("5 legal places · 3 free to start"). The score, the
// count and the year that used to sit in a strip here are in the hero.
const freeNow = freeSplit(links).free.length

// Our own words, written at build time from the facts in the record. This is
// the main text of the page. See src/lib/prose.mjs.
const overview = { lede: ledeOf(item.overview), paragraphs: aboutParagraphs(item.overview) }

// The publisher blurb is somebody else's writing, so it sits under our own
// text and keeps its credit. AniList puts that credit inside the blurb.
const rawSynopsis = (item.description || '').replace(/\n{2,}/g, '\n\n').trim()
const creditMatch = rawSynopsis.match(/\(Source:\s*([^)]+)\)/i)
const synopsisCredit = creditMatch ? creditMatch[1].trim() : null
const synopsis = rawSynopsis.replace(/\(Source:[^)]*\)/gi, '').trim()
const description = links.length
  ? `${item.title} is officially ${isComic ? 'readable' : 'streaming'} on ${platformNames
      .slice(0, 3)
      .join(', ')}${platformNames.length > 3 ? ` and ${platformNames.length - 3} more` : ''}. ` +
    `${statusWord(item.status)}${item.chapters ? `, ${item.chapters} chapters` : ''}${
      item.episodes ? `, ${item.episodes} episodes` : ''
    }.`
  : `${item.title} has no official English ${isComic ? 'reading' : 'streaming'} platform listed yet. Here is what we know about it.`

// AniList keeps its own charts. "#2 most popular of all time" is a real fact
// about a story and nothing else on this page says it. Only an all-time place
// is printed: a yearly place needs the year beside it to mean anything, and
// the facts list has no room for that.
const chartWord = { POPULAR: 'most popular', RATED: 'highest rated' }
const chart = (item.ranks || []).find((r) => r.allTime && chartWord[r.type])

// How many people are reading it right now, and how many finished it. These
// are the numbers a reader uses to decide if a story is worth starting.
const readers = item.readers || {}
const num = (value) => (value ? Number(value).toLocaleString() : null)

// What the story was made from. AniList stores it as MANGA, LIGHT_NOVEL and
// so on, which is not a thing anybody says out loud.
const SOURCE_WORDS = {
  ORIGINAL: 'An original story',
  MANGA: 'A manga',
  LIGHT_NOVEL: 'A light novel',
  WEB_NOVEL: 'A web novel',
  NOVEL: 'A novel',
  VISUAL_NOVEL: 'A visual novel',
  VIDEO_GAME: 'A video game',
  DOUJINSHI: 'A doujinshi',
  ANIME: 'An anime',
  COMIC: 'A comic',
  GAME: 'A game',
  PICTURE_BOOK: 'A picture book',
  MULTIMEDIA_PROJECT: 'A multimedia project',
  LIVE_ACTION: 'A live action show',
}

// The facts, in two groups. The core ones (what it is, how long, who, where
// from) sit in the Quick facts card beside the About text; the rest (charts,
// reader counts, the next airing, favourites) open the Details section lower
// down. Every row of the old single table is in one of the two.
const quickFacts = [
  ['Status', statusWord(item.status)],
  isComic ? ['Chapters', item.chapters ?? 'Not counted'] : ['Episodes', item.episodes ?? 'Not counted'],
  isComic ? ['Volumes', item.volumes ?? '—'] : ['Studio', item.studios[0] ?? '—'],
  ['Format', word],
  ...(SOURCE_WORDS[item.source] ? [['Based on', SOURCE_WORDS[item.source]]] : []),
  ['Country', { KR: 'South Korea', JP: 'Japan', CN: 'China', TW: 'Taiwan' }[item.country] || '—'],
  ['First released', item.startYear ?? '—'],
  // make-shards.mjs sets seasonHub only when that season's hub page was built.
  ...(!isComic && item.seasonHub
    ? [[seasonWhen(item.seasonYear, item.season) > 0 ? 'Airs' : 'Aired', { text: `${seasonLabel(item.season)} ${item.seasonYear}`, href: seasonPath(item.seasonYear, item.season) }]]
    : []),
  ...(item.authors?.length ? [['Author', item.authors.map((a) => a.name).join(', ')]] : []),
]
const moreFacts = [
  ...(chart ? [['AniList chart', `#${chart.rank} ${chartWord[chart.type]} of all time`]] : []),
  ...(num(readers.current) ? [[isComic ? 'Reading now' : 'Watching now', num(readers.current)]] : []),
  ...(num(readers.completed) ? [['Finished it', num(readers.completed)]] : []),
  ...(nextEp ? [[`Episode ${item.nextEpisode.number} airs`, nextEp]] : []),
  ...(item.favourites ? [['AniList favourites', item.favourites.toLocaleString()]] : []),
]

// AniList sometimes returns the video id with trailing whitespace, which
// would make every URL built from it invalid.
const trailer = item.trailer
  ? {
      id: String(item.trailer.id).trim(),
      thumb: item.trailer.thumb ? String(item.trailer.thumb).trim() : null,
    }
  : null

// The index rebuilds every day, so every page carries the date of the last
// check against AniList, even when its own record did not change.
const updated = checkedISO

// The names a reader may already know this by. AniList keeps them, and a
// reader who only knows the fan name should still land on the right page.
// Only Latin-script names are shown: the native name has its own line above,
// and a Russian or Chinese alias helps nobody reading this page in English.
const alsoKnown = [...new Set((item.synonyms || []).filter((n) => /^[ -~À-ɏ'’!?.,:&()-]+$/.test(n)))]
  .filter((n) => n.toLowerCase() !== (item.title || '').toLowerCase())
  .filter((n) => n.toLowerCase() !== (item.titleRomaji || '').toLowerCase())
  .slice(0, 5)

// A reader who finished a series often wants to own it. We sell nothing and
// stock nothing, so these open a search on Amazon and let the reader see what
// is really in print.
const buys = shopLinks(item, countryOf(Astro), { books: booksKnown(item) })

// Real products picked by hand for the biggest series, shown only to readers on
// amazon.com (see src/lib/picks.js). A sequel or an adaptation borrows the
// picks of its own story, and the heading then names that story.
const picked = picksShowFor(countryOf(Astro)) ? picksForTitle(item) : null
// The words at the top of the shopping box, fitted to this title: licensed or
// not, finished or still going, anime or comic. See src/lib/buy-copy.js.
const buyCopy = titleBuyCopy(item, {
  books: booksKnown(item),
  printKnown: Boolean(picked?.picks?.some((pick) => pick.t === 'book')),
})

// An anime's key credits (director, writer, designer, composer), from AniList.
// Grouped by role so two composers share one row. Empty on a comic and on any
// anime the record has no credits for yet, and then nothing below is drawn.
const staff = isComic ? [] : item.staff || []
const staffRows = [...new Set(staff.map((s) => s.role))].map((role) => [
  role,
  staff.filter((s) => s.role === role).map((s) => s.name).join(', '),
])
const people = (...roles) =>
  staff.filter((s) => roles.includes(s.role)).map((s) => ({ '@type': 'Person', name: s.name }))
const director = people('Director')
const musicBy = people('Music')
const creator = people('Original Creator', 'Original Story')

const voices = await voicesRead
// Owner's choice (3 Oct 2026): title pages keep the full day at the edge, so new
// votes and approved reviews show within 24 hours. Only a page drawn while D1
// was slow asks for a short life, so the gap is not frozen for a day.
if (!voices.ok) Astro.response.headers.set(EDGE_HEADER, String(DEGRADED_EDGE_SECONDS))
const readerRating = aggregateJsonld(voices.rating)

const jsonld = {
  '@context': 'https://schema.org',
  '@type': isComic ? 'Book' : 'TVSeries',
  '@id': `https://manhwaindex.com/${Astro.params.kind}/${item.slug}#item`,
  url: `https://manhwaindex.com/${Astro.params.kind}/${item.slug}`,
  inLanguage: 'en',
  dateModified: updated,
  name: item.title,
  alternateName: [item.titleNative, item.titleRomaji, ...alsoKnown].filter(Boolean),
  image: item.cover,
  description: truncate(overview.lede || item.description, 400),
  genre: item.genres,
  ...(item.kind === 'comic' ? { bookFormat: 'https://schema.org/GraphicNovel' } : {}),
  ...(item.kind === 'novel' ? { bookFormat: 'https://schema.org/EBook' } : {}),
  ...(item.episodes ? { numberOfEpisodes: item.episodes } : {}),
  ...(item.authors?.length ? { author: item.authors.map((a) => ({ '@type': 'Person', name: a.name })) } : {}),
  ...(director.length ? { director } : {}),
  ...(musicBy.length ? { musicBy } : {}),
  ...(creator.length ? { creator } : {}),
  // No trailer block here on purpose. Google needs an uploadDate on a video
  // and AniList never gives one, so every trailer we described was marked
  // invalid in Search Console. A made-up date would be worse than no block.
  // The trailer still plays further down the page.
  // The AniList score is never marked up. It is AniList's, not our readers',
  // and Google's rules forbid marking up ratings taken from another site.
  // Counting favourites as ratings made it worse. One manual action for
  // "spammy structured data" would hit every title page at once. The score
  // still shows on the page as plain text; favourites are described as what
  // they are: people who marked the title a favourite.
  //
  // The aggregateRating below is different: it is our own readers' stars,
  // given on this page and printed on it in "What readers think". It is only
  // added from five votes (SCHEMA_FROM in src/lib/reviews.mjs), and the
  // reviews only once the owner approved them, the same ones the page draws.
  ...(readerRating ? { aggregateRating: readerRating } : {}),
  ...(voices.reviews.length ? { review: reviewsJsonld(voices.reviews) } : {}),
  ...(item.favourites
    ? {
        interactionStatistic: {
          '@type': 'InteractionCounter',
          interactionType: 'https://schema.org/LikeAction',
          userInteractionCount: item.favourites,
        },
      }
    : {}),
  ...(links.length
    ? {
        potentialAction: links.map((l) => ({
          '@type': isComic ? 'ReadAction' : 'WatchAction',
          target: l.url,
          name: l.site,
        })),
      }
    : {}),
}
// The first twelve faces. An anime record also names the voices; the Cast
// block prints them under each face (src/components/detail/Cast.astro).
const cast = charactersOf(item).slice(0, 12)
// Sub or dub, from the whole cast list, not just the twelve faces shown.
// Says nothing when the record has no voice credits (src/lib/dub.mjs).
const dub = isComic ? null : dubOf(item)

// You may also like: worked out at build time and stored in the record,
// so the Worker does no searching at request time.
const similar = item.similar || []
const similarBase = isComic ? `/${word}` : '/anime'

// What AniList readers themselves picked next after this story. A human vote
// beats a genre match, so it gets its own block above the genre one. The list
// can hold both comics and anime, so the grid works out each address itself.
// Anything already shown as a genre pick is dropped, so the page never shows
// the same cover twice.
const shownSlugs = new Set(similar.map((p) => p.slug))
const recs = (item.recs || []).filter((p) => p.slug !== item.slug && !shownSlugs.has(p.slug))
const kindBase = similarBase
const kindLabel = word.charAt(0).toUpperCase() + word.slice(1)

// The family tree: prequels, sequels, side stories, spin-offs.
// Adaptations are left out — the anime/original sections above cover them.
const RELATION_LABEL = {
  PREQUEL: 'Prequel',
  PARENT: 'Main story',
  SEQUEL: 'Sequel',
  SIDE_STORY: 'Side story',
  SPIN_OFF: 'Spin-off',
  ALTERNATIVE: 'Alternative version',
}
const RELATION_ORDER = Object.keys(RELATION_LABEL)
const family = (item.relations || [])
  .filter((r) => RELATION_LABEL[r.relation])
  .sort((a, b) => RELATION_ORDER.indexOf(a.relation) - RELATION_ORDER.indexOf(b.relation))

const FAMILY_WORDS = { TV: 'anime series', MOVIE: 'anime film', SPECIAL: 'anime special', OVA: 'OVA', ONA: 'ONA' }
const familyWord = (r) =>
  r.type === 'ANIME'
    ? FAMILY_WORDS[r.format] || 'anime'
    : r.format === 'NOVEL'
      ? 'novel'
      : { KR: 'manhwa', JP: 'manga', CN: 'manhua', TW: 'manhua' }[r.country] || 'comic'

// Which languages have an official release. English leads: it is the
// question most visitors are really asking. Anime links carry no
// language data, so this stays comic-only.
// Platforms with a free tier or free chapters — the answer most
// visitors actually came for, so it gets its own line up top.
// MAL score + cross-site links, when the enrichment pull has data for us.
const extra = enrichOf(item)
const malScore = extra.mal && extra.mal.score ? extra.mal : null
const alsoSites = item.kind === 'anime'
  ? extra.sites || []
  : malScore && malScore.url
    ? [{ name: 'MyAnimeList', url: malScore.url }]
    : []

const freeLinks = []
{
  const seen = new Set()
  for (const link of links) {
    if (seen.has(link.site)) continue
    if ((platform(link.site).note || '').toLowerCase().includes('free')) {
      seen.add(link.site)
      freeLinks.push(link)
    }
  }
}

const languages = isComic ? [...new Set(links.map((l) => l.language).filter(Boolean))] : []
const hasEnglish = languages.includes('English')
const otherLanguages = languages.filter((l) => l !== 'English')

// The opening paragraph of Read / Watch: this title's own "at a glance" facts,
// written at build time (src/lib/prose.mjs, via src/lib/title-answer.mjs).
// The site-wide promises live on /how-we-check-links, linked once under it.
const verb = isComic ? 'read' : 'watch'
const answer = titleAnswer(item, word)

// The questions people type instead of reading a table. Both the block and
// the two answer pages below are built from this same record, so they can
// never drift away from the table above them. Each link below shows only when
// its page passes the gate in src/lib/gates.mjs, the same gate the page itself
// runs before it answers 404, so a reader is never sent to a dead end.
const faq = titleFaq(item, kind)
// Each answer page is linked from the section it answers: the free page from
// Watch / Read, the buy page from the shop, the "like" page from the picks at
// the end, the full cast from the cast grid.
const freePage = hasFreePage(item)
  ? {
      href: `/${kind}/${item.slug}/free`,
      lead: 'The free question',
      title: `Where to ${verb} ${item.title} free and legal`,
      note: 'How much each platform gives away, and what the rest costs',
    }
  : null
// A reader who has decided they want to OWN it is asking a different
// question from the table above. Only stories people really search for get
// that page, so the link only shows when the page exists.
const buyPage = hasBuyPage(item)
  ? {
      href: `/${kind}/${item.slug}/buy`,
      lead: 'If you want to own it',
      title: `Where to buy ${item.title}`,
      note: isComic
        ? 'Printed volumes, figures, art books and posters, in your own store'
        : 'Discs, figures, art books and posters, in your own store',
    }
  : null
const likePage = hasLikePage(item)
  ? {
      href: `/${kind}/${item.slug}/like`,
      lead: 'If you finished it',
      title: `${kindLabel} like ${item.title}`,
      note: `${similar.length} close matches, each with its official platforms`,
    }
  : null
// A whole cast list. The block above only shows the first twelve faces, and
// people search for the rest by the story name.
const castPage = hasCastPage(item)
  ? {
      href: `/${kind}/${item.slug}/characters`,
      lead: 'Everyone in it',
      title: `All characters in ${item.title}`,
      note: `${charactersOf(item).length} faces, each with its own page`,
    }
  : null

// Facts this site works out for itself: how wide the official coverage is,
// how the anime and the comic line up, and the order to read the series in.
// See src/lib/computed.mjs.
// What is coming next: an episode, an announced anime, or an announced part.
// It is worked out at request time, so a date that has passed never shows.
const ahead = upcoming(item, kind)
const reach = coverage(links, kind)
const bridge = adaptationAnswer(item, kind)
const order = readingOrder(item, kind)

const updatedLong = checkedLong

// The sections this page really has, in page order. The jump chips (phones,
// tablets) and the rail (wide screens) both draw from this one list.
const hasThemes = !isComic && (item.themes || []).length > 0
const hasEpisodes = !isComic && (item.episodeList || []).length > 0
const hasRelated = isComic || related.length > 0 || Boolean(bridge) || Boolean(order) || family.length > 0
const jumpLinks = [
  { id: isComic ? 'read' : 'watch', label: isComic ? 'Read' : 'Watch' },
  { id: 'about', label: 'About' },
  cast.length > 0 ? { id: 'cast', label: isComic ? 'Characters' : 'Cast' } : null,
  hasEpisodes ? { id: 'episodes', label: 'Episodes' } : null,
  hasThemes ? { id: 'music', label: 'Music' } : null,
  hasRelated ? { id: 'related', label: 'Related' } : null,
  { id: 'reader-ratings', label: 'Reviews' },
  faq.length > 0 ? { id: 'faq', label: 'FAQ' } : null,
].filter(Boolean)
---

<Base
  title={pageTitle}
  description={description}
  image={item.cover}
  jsonld={faq.length ? [jsonld, faqJsonld(faq)] : jsonld}
  crumbs={[{ name: kindLabel, href: kindBase }, { name: item.title }]}
>
  <div class="dp">
    <DetailHero
      item={item}
      kind={kind}
      isComic={isComic}
      kindLabel={kindLabel}
      kindBase={kindBase}
      alsoKnown={alsoKnown}
      malScore={malScore}
      dub={dub}
      ahead={ahead}
      whereHref={isComic ? '#read' : '#watch'}
    />

    <JumpNav links={jumpLinks} />

    <div class="dp-shell dp-body">
      <div class="dp-main">
        <WhereTo
          item={item}
          isComic={isComic}
          word={word}
          links={links}
          answer={answer}
          checked={updatedLong}
          freeLinks={freeLinks}
          freeCount={freeNow}
          reach={reach}
          showAlike={needsAlike(item)}
          languages={languages}
          freePage={freePage}
          titlePage
        />

        {/* Straight under the platforms: placed after Related (3 Oct 2026),
            Amazon clicks fell from about 2 an hour to 2 in 15 hours. */}
        <Shop
          title={item.title}
          item={item}
          picked={picked}
          buys={buys}
          buyCopy={buyCopy}
          buyPage={buyPage}
          trial={trialFor(item, countryOf(Astro))}
          art={{ cover: item.cover, banner: item.banner, portrait: cast[0]?.image }}
        />

        <About
          title={item.title}
          overview={overview}
          synopsis={synopsis}
          synopsisCredit={synopsisCredit}
          quickFacts={quickFacts}
          trailer={trailer}
        />

        <Cast cast={cast} isComic={isComic} castPage={castPage} />

        {!isComic && <EpisodeList rows={item.episodeList} title={item.title} />}

        {!isComic && <Themes id="music" themes={item.themes} title={item.title} country={countryOf(Astro)} />}

        <Related
          item={item}
          isComic={isComic}
          related={related}
          order={order}
          bridge={bridge}
          family={family}
          relationLabel={RELATION_LABEL}
          familyWord={familyWord}
        />

        <Details
          facts={moreFacts}
          staffRows={staffRows}
          anilistUrl={item.anilistUrl}
          alsoSites={alsoSites}
          whereUrl={!isComic && item.whereSlug ? whereAnimeUrl(item.whereSlug) : null}
        />

        <Ratings
          id={item.id}
          kind={kind}
          slug={item.slug}
          title={item.title}
          rating={voices.rating}
          reviews={voices.reviews}
        />

        <Faq faq={faq} />

        <FeaturedIn media={item.id} />

        <AlsoLookFor path={Astro.url.pathname} frame="answer" />

        <MoreLike
          title={item.title}
          isComic={isComic}
          word={word}
          recs={recs}
          similar={similar}
          similarBase={similarBase}
          likePage={likePage}
        />
      </div>

      <DetailRail score={item.score} malScore={malScore} links={jumpLinks} />
    </div>
  </div>
</Base>
