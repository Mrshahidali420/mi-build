---
/**
 * Search. What people look for with the site's own search box.
 *
 * Only two things are ever sent (see /privacy): the result a person picked,
 * and the words of a search that found nothing, cleaned of anything that
 * looks like an e-mail, a link or a phone number. The words are shown here
 * only when two or more different people typed the same thing.
 */
import Admin from '../../layouts/Admin.astro'
import Hint from '../../components/admin/Hint.astro'
import BarList from '../../components/admin/BarList.astro'
import Kpi from '../../components/admin/Kpi.astro'
import Split from '../../components/admin/Split.astro'
import WeekStrip from '../../components/admin/WeekStrip.astro'
import TapList from '../../components/admin/TapList.astro'
import KeepForm from '../../components/admin/KeepForm.astro'
import { envOf } from '../../lib/runtime.js'
import { gate, rangeOf, humanize, num, ask } from '../../lib/admin.js'
import { KEEP_LIST } from '../../lib/owner-rules.mjs'
import { actionsFor, tally } from '../../lib/admin-more.js'
import { missingTitleHint } from '../../lib/admin-hints.js'
import { searchArrivalsFor, searchedTitles, enginesLine } from '../../lib/admin-searching.js'
import plan from '../../../data/home-auto.json'

export const prerender = false

const env = envOf(Astro)
const { db, secret, signedIn, wrongWord } = await gate(Astro, env)
if (secret && !signedIn && Astro.request.method !== 'POST') {
  return Astro.redirect('/my-admin')
}

const range = rangeOf(Astro.url, '7d')

let rows = []
let arrivals = []
let kept = []
if (signedIn) {
  ;[rows, arrivals, kept] = await Promise.all([
    actionsFor(db, range, ['search_pick', 'search_none', 'search_none_all'], 1000),
    searchArrivalsFor(db),
    ask(db, KEEP_LIST),
  ])
}

// The ids kept with the box below. Read by the nightly refresh together with
// data/keep.json (scripts/keep-list.mjs).
const shortDay = (iso) => new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' })
const keptRows = kept.map((row) => ({
  id: row.anilist_id,
  name: row.note || `AniList #${row.anilist_id}`,
  href: `https://anilist.co/manga/${row.anilist_id}`,
  sub: `id ${row.anilist_id} · added ${shortDay(row.created_at)}`,
  kind: 'keep',
  rule: { action: 'keep', source: 'db' },
}))

const picks = rows.filter((row) => row.name === 'search_pick')
const nones = rows.filter((row) => row.name === 'search_none')
// Every search that found nothing, counted without its words.
const noneAll = rows.filter((row) => row.name === 'search_none_all')
const counted = [...picks, ...noneAll]
const total = counted.reduce((n, row) => n + (row.n || 0), 0)
const noneTotal = noneAll.reduce((n, row) => n + (row.n || 0), 0)

const surfaces = tally(counted, (row) => row.detail)
const surfaceParts = [
  { name: 'Box at the top', value: surfaces.find((row) => row.key === 'dropdown')?.n || 0, tone: 'blue' },
  { name: 'Full search page', value: surfaces.find((row) => row.key === 'page')?.n || 0, tone: 'violet' },
]
const pickTotal = picks.reduce((n, row) => n + (row.n || 0), 0)
const noneShare = total ? Math.round((noneTotal / total) * 100) : 0

const found = tally(picks, (row) => row.item).slice(0, 15)
const foundRows = found.map((row) => ({
  name: row.label || humanize(row.key, ''),
  href: row.key,
  sub: row.key,
  value: row.n,
  unit: 'picks',
}))

// The same picks, by title: a pick of a title's /characters page is a search
// for that title. "people" over several days is people per day added up.
const searchedRows = searchedTitles(picks).slice(0, 15).map((row) => ({
  name: row.label || humanize(row.key, ''),
  href: row.key,
  sub: `${num(row.people)} people · ${num(row.n)} picks`,
  value: row.people,
  unit: 'people',
}))

// Found on Google and the other engines: the last 7 closed days against the
// usual, the same numbers the homepage shelf is planned from.
const arrivalRows = arrivals.map((row) => ({
  name: row.label || humanize(row.page, ''),
  href: row.page,
  sub: `${row.lift.toFixed(1)}x its usual · ${enginesLine(row.engines)} · about ${num(row.people7)} people`,
  value: row.g7,
  unit: 'arrivals',
  tone: row.lift >= 1.5 ? 'good' : undefined,
}))
const shelf = plan?.sections?.searching
const shelfLine = shelf
  ? `${shelf.enabled ? 'Shown' : 'Hidden'} on the homepage with ${shelf.items.length} titles; ${(plan?.next?.searching || []).length} would be next.`
  : 'Not planned yet.'

const missing = tally(nones, (row) => row.item).slice(0, 30)
// Each miss opens the same words on AniList, where the id for data/keep.json
// is found in one tap. Comics first: most searches here are for a comic, and
// the AniList page has an Anime tab one tap away.
const anilistSearch = (words) => `https://anilist.co/search/manga?search=${encodeURIComponent(words)}`
const missingRows = missing.map((row) => ({
  name: `“${row.key}”`,
  href: anilistSearch(row.key),
  target: true,
  sub: `${num(row.people)} people · find its id on AniList`,
  value: row.n,
  unit: 'searches',
  tone: 'bad',
}))
---


<Admin
  title="Search"
  here="/my-admin/search"
  range={range}
  signedIn={signedIn}
  secret={secret}
  wrongWord={wrongWord}
  note={`${range.label}. The site's own search box, and which titles people find on Google. What they type into Google is only in Search Console.`}
>
  {signedIn && <WeekStrip db={db} />}

  <section class="kpis" aria-label="Searches at a glance">
    <Kpi label="Searches" value={total} hero />
    <Kpi label="Found a result" value={pickTotal} />
    <Kpi label="Found nothing" value={noneTotal} unit={total ? `${noneShare}%` : ''} />
  </section>

  <div class="panel wide">
    <h2>How much do people search, and where?</h2>
    <p class="say">A search is counted when a result is picked, or when it finds nothing.</p>
    {total === 0 ? (
      <p class="empty">No searches counted in this window yet.</p>
    ) : (
      <Split parts={surfaceParts} label="Which search box" />
    )}
  </div>

  <div class="panel wide">
    <h2>Which titles are people finding on Google more than usual?</h2>
    <p class="say">
      Page views that arrived from a search engine, last 7 closed days, against the title's
      usual week. Answer pages count for their title. Always the last 7 days, whatever the range.
    </p>
    <BarList rows={arrivalRows} tone="good" empty="No search-engine arrivals counted yet. The night job fills this in." />
    <p class="say">
      The homepage shelf planned from these numbers ("Hot this week"): {shelfLine} <a href="/my-admin/homepage">Homepage tab →</a>
    </p>
  </div>

  <div class="panel">
    <h2>Which titles do people search for here?</h2>
    <p class="say">Search results picked, by title, most people first.</p>
    <BarList rows={searchedRows} empty="Nobody picked a search result yet." />
  </div>

  <div class="panel">
    <h2>What do they find?</h2>
    <p class="say">The results people picked most.</p>
    <BarList rows={foundRows} empty="Nobody picked a search result yet." />
  </div>

  <div class="panel">
    <h2>What did they look for and not find?</h2>
    <p class="say">
      Only words that two or more different people searched for are shown. A
      title here is one people want and the index does not hold.
    </p>
    <BarList rows={missingRows} empty="Nothing yet. Words show here once two different people search for the same missing title." />
    <Hint hint={missingTitleHint(missing.length)} />
    <h3>Add one to the keep list</h3>
    <p class="say">
      Tap a search above, open the right title on AniList, and copy the number from its
      address (anilist.co/manga/<b>12345</b>), or copy the whole address. Put it in the box.
      The title is fetched at tonight's update and its page appears on that build.
    </p>
    {signedIn && <KeepForm />}
    <h3>Your keep list</h3>
    <p class="say">Added here. The ids in data/keep.json are kept too.</p>
    <TapList rows={keptRows} empty="Nothing added here yet." />
  </div>

  <p class="say">
    Searches on Google that led here:
    <a href="https://search.google.com/search-console" rel="noopener" target="_blank">open Search Console</a>.
  </p>
</Admin>
