---
/**
 * This week. The last seven full days against the seven before them, and the
 * three things most worth doing today, picked from every tab.
 *
 * Full days only, from the nightly tables: today is half a day and would make
 * every week look like a fall. So this page reads a few dozen small rows and
 * is cheap to open as often as you like.
 */
import Admin from '../../layouts/Admin.astro'
import Hint from '../../components/admin/Hint.astro'
import BarList from '../../components/admin/BarList.astro'
import Kpi from '../../components/admin/Kpi.astro'
import Trend from '../../components/admin/Trend.astro'
import { envOf } from '../../lib/runtime.js'
import { gate, rangeOf, countryName, dayKey, humanize, num, sourceName } from '../../lib/admin.js'
import { countriesFor, pagesFor } from '../../lib/admin-data.js'
import {
  actionsFor,
  counterHealth,
  dailySeries,
  quickExitsFor,
  weekPlatforms,
  weekSources,
  weekTotals,
  weeks,
  SERIES_FIELDS,
} from '../../lib/admin-more.js'
import { deltaOf, fillDays, flagOf } from '../../lib/admin-chart.js'
import homeLog from '../../../data/home-decisions.json'
import {
  entryPageHint,
  missingTitleHint,
  newSourceHint,
  platformHint,
  quickExitHint,
  rollupHint,
  topHints,
  trafficHint,
} from '../../lib/admin-hints.js'

export const prerender = false

const env = envOf(Astro)
const { db, secret, signedIn, wrongWord } = await gate(Astro, env)
if (secret && !signedIn && Astro.request.method !== 'POST') {
  return Astro.redirect('/my-admin')
}

const w = weeks()
const week = rangeOf(new URL('?range=7d', Astro.url))

let totals = { now: {}, before: {} }
let sources = { now: [], before: [] }
let platforms = { now: [], before: [] }
let countries = []
let pages = []
let quick = new Map()
let misses = []
let health = { log: [], today: 0 }
let series = []

if (signedIn) {
  ;[totals, sources, platforms, countries, pages, quick, misses, health, series] = await Promise.all([
    weekTotals(db, w),
    weekSources(db, w),
    weekPlatforms(db, w),
    countriesFor(db, week, 8),
    pagesFor(db, week),
    quickExitsFor(db, week),
    actionsFor(db, week, ['search_none']),
    counterHealth(db),
    // 14 small rows: the two weeks, day by day, for the trend lines.
    dailySeries(db, w.before.from, w.now.to),
  ])
}
const days = fillDays(series, w.before.from, w.now.to, SERIES_FIELDS)
const thisWeek = days.slice(-7)
const sumOf = (list, field) => list.reduce((n, row) => n + (row[field] || 0), 0)
const savesNow = sumOf(thisWeek, 'saves')
const savesBefore = sumOf(days.slice(0, 7), 'saves')
const line = (field) => days.map((row) => row[field] || 0)

const a = totals.now
const b = totals.before
const closedDays = a.days || 0

// Senders, by visits that started from them.
const top5 = sources.now.slice(0, 5)
const beforeBy = new Map(sources.before.map((row) => [row.source, row]))
const sourceRows = top5.map((row) => {
  const was = beforeBy.get(row.source)?.entries
  return {
    name: sourceName(row.source),
    delta: deltaOf(row.entries, was),
    sub: was ? '' : 'new this week',
    value: row.entries || 0,
    unit: 'visits',
  }
})

// The platform readers pick most, this week.
const platformTop = [...platforms.now].sort((x, y) => (y.clicks || 0) - (x.clicks || 0))[0]

// One hint per tab, then the best three of them.
const entryPage = pages.find((row) => entryPageHint(row))
const quickPage = pages
  .map((row) => ({ ...row, quick_exits: quick.get(row.path) || 0 }))
  .find((row) => quickExitHint(row))
const named = (row, h) => h && { ...h, text: `${humanize(row.path, row.label)}: ${h.text}` }
const hints = topHints([
  rollupHint(health.log[0]?.day, dayKey(1)),
  trafficHint(a.visits, b.visits),
  named(entryPage, entryPage && entryPageHint(entryPage)),
  named(quickPage, quickPage && quickExitHint(quickPage)),
  missingTitleHint(misses.length) && {
    ...missingTitleHint(misses.length),
    text: `${num(misses.length)} searched ${misses.length === 1 ? 'title was' : 'titles were'} not found. See the Search tab.`,
  },
  newSourceHint(top5, sources.before, sourceName),
  platformTop && platformHint({ name: platformTop.platform, total: platformTop.clicks }),
])

// The last three things the homepage planner did by itself, so a change on
// the homepage is never a surprise. The full log is on the Homepage tab.
const homeChanges = (Array.isArray(homeLog) ? homeLog : [])
  .filter((d) => d && ['add', 'drop', 'show', 'hide', 'skip'].includes(d.action))
  .slice(0, 3)
  .map((d) => ({
    name: [d.night, d.section === 'all' ? '' : d.section, d.action, d.title].filter(Boolean).join(' · '),
    href: d.path || undefined,
    sub: d.reason,
    value: '',
    tone: d.action === 'skip' ? 'bad' : undefined,
  }))

const countryRows = countries.map((row) => ({
  name: `${flagOf(row.country) ? `${flagOf(row.country)}  ` : ''}${countryName(row.country)}`,
  value: row.views || 0,
  unit: 'views',
}))

// Read and watch clicks per platform, this week against last week.
const platformBefore = new Map(platforms.before.map((row) => [row.platform, row.clicks || 0]))
const platformRows = [...platforms.now]
  .sort((x, y) => (y.clicks || 0) - (x.clicks || 0))
  .slice(0, 8)
  .map((row) => ({
    name: row.platform || 'Unknown',
    icon: row.platform || '?',
    delta: deltaOf(row.clicks, platformBefore.get(row.platform)),
    value: row.clicks || 0,
    unit: 'clicks',
  }))
---

<Admin
  title="This week"
  here="/my-admin/week"
  signedIn={signedIn}
  secret={secret}
  wrongWord={wrongWord}
  note={`${w.now.from} to ${w.now.to}, the last seven full days, against the seven before.`}
>
  <div class="panel todo">
    <h2>What should I do today?</h2>
    {hints.length === 0 && <p class="empty">Nothing needs you today. The numbers are steady.</p>}
    {hints.map((h) => <Hint hint={h} />)}
    {homeChanges.length > 0 && (
      <>
        <h3>What the homepage changed by itself</h3>
        <BarList rows={homeChanges} />
        <p class="more"><a href="/my-admin/homepage">Homepage tab →</a></p>
      </>
    )}
  </div>

  {closedDays === 0 ? (
    <p class="empty wide">No closed days yet. The night job fills this after 00:10 UTC (05:10 PKT).</p>
  ) : (
    <section class="kpis" aria-label="This week against last week">
      <Kpi label="Visits" value={a.visits || 0} now={a.visits} before={b.visits} spark={line('visits')} hero />
      <Kpi label="Page views" value={a.views || 0} now={a.views} before={b.views} spark={line('views')} />
      <Kpi label="Clicks out" value={a.clicks || 0} now={a.clicks} before={b.clicks} spark={line('clicks')} tone="amber" />
      <Kpi label="Titles saved to lists" value={savesNow} now={savesNow} before={savesBefore} spark={line('saves')} tone="violet" />
      <Kpi label="Left at once" value={a.quick_exits || 0} now={a.quick_exits} before={b.quick_exits} spark={line('quick_exits')} tone="bad" lowerIsBetter />
    </section>
  )}

  <div class="panel wide">
    <h2>How many people came, day by day?</h2>
    <p class="say">The last 14 full days. The line is visits; the dashed line is clicks out, on its own scale.</p>
    {closedDays > 0 && closedDays < 7 && <p class="say">Only {closedDays} of the 7 days are closed so far.</p>}
    <Trend
      series={days}
      lines={[
        { field: 'visits', name: 'Visits', tone: 'blue' },
        { field: 'clicks', name: 'Clicks out', tone: 'amber' },
      ]}
      height={110}
      label="Visits and clicks out, last 14 days"
    />
  </div>

  <div class="panel">
    <h2>Where did they come from?</h2>
    <p class="say">The five senders that started the most visits, against last week.</p>
    <BarList rows={sourceRows} empty="No visits recorded this week yet." />
    <Hint hint={newSourceHint(top5, sources.before, sourceName)} />
  </div>

  <div class="panel">
    <h2>Which platforms got the clicks?</h2>
    <p class="say">Read and watch clicks this week, against last week.</p>
    <BarList rows={platformRows} tone="violet" empty="No read or watch clicks this week yet." />
  </div>

  <div class="panel">
    <h2>Which countries?</h2>
    <p class="say">Page views, last 7 days including today. This decides which Amazon store matters.</p>
    <BarList rows={countryRows} empty="No page views yet." />
    <p class="more"><a href="/my-admin/sections?range=7d">Every section, source and country →</a></p>
  </div>
</Admin>
