---
/**
 * Pages. Which page does its job, and which page only collects visitors.
 *
 * The job of a page here is the hand-off: the reader arrives, and leaves
 * through a read, watch or buy link. So the ranking is by hand-off rate, not
 * by views. Journeys and Sections hang under this tab.
 */
import Admin from '../../layouts/Admin.astro'
import Hint from '../../components/admin/Hint.astro'
import BarList from '../../components/admin/BarList.astro'
import Kpi from '../../components/admin/Kpi.astro'
import Trend from '../../components/admin/Trend.astro'
import { envOf } from '../../lib/runtime.js'
import { gate, rangeOf, countryName, fmtDwell, handOff, humanize, num, sectionName, withRange } from '../../lib/admin.js'
import { edgesFor, pagesFor, totalsFor } from '../../lib/admin-data.js'
import { closedDaysFor, liftsFor, quickExitsFor } from '../../lib/admin-more.js'
import { liftsOf, baseDaysOf, RISING } from '../../lib/home-plan.mjs'
import { flagOf, withToday } from '../../lib/admin-chart.js'
import { entryPageHint, quickExitHint, MIN_ENTRIES } from '../../lib/admin-hints.js'
import { countriesForPaths, titlesForPaths, COUNTRY_DAYS } from '../../lib/admin-extra.js'
import { deadEnds, deadReason, countriesByPath, isTitlePath, usualRate, DEAD_MIN_ENTRIES } from '../../lib/admin-insights.js'
import WeekStrip from '../../components/admin/WeekStrip.astro'

export const prerender = false

const env = envOf(Astro)
const { db, secret, signedIn, wrongWord } = await gate(Astro, env)
if (secret && !signedIn && Astro.request.method !== 'POST') {
  return Astro.redirect('/my-admin')
}

const range = rangeOf(Astro.url)

// A page needs this many views before its hand-off rate means anything. One
// visitor who clicked is 100 percent, and that number says nothing.
const FLOOR = 20

let rows = []
let totals = {}
let quick = new Map()
let edges = []
let closedDays = []
let lifts = { rows: [], historyStart: null, night: '' }

if (signedIn) {
  ;[rows, totals, quick, edges, closedDays, lifts] = await Promise.all([
    pagesFor(db, range),
    totalsFor(db, range),
    quickExitsFor(db, range),
    edgesFor(db, range, 8),
    closedDaysFor(db, range),
    liftsFor(db, Date.now(), RISING.minOpens7),
  ])
}

// --- Dead ends and where readers come from. Arrivals are not kept for All
// time, so the dead-end list needs a shorter range; the country mix always
// reads the last 7 days of raw views, for a short list of paths only.
const usual = usualRate(rows)
const dead = range.mode !== 'all' ? deadEnds(rows, { usual }) : []
const topTitles = rows.filter((row) => isTitlePath(row.path)).slice(0, 15)
let mix = new Map()
let records = new Map()
if (signedIn && (dead.length || topTitles.length)) {
  try {
    const [countryRaw, recs] = await Promise.all([
      countriesForPaths(db, [...dead.map((r) => r.path), ...topTitles.map((r) => r.path)]),
      titlesForPaths(env, dead.map((r) => r.path)),
    ])
    mix = countriesByPath(countryRaw)
    records = recs
  } catch {
    // Without the mix the lists still draw, just without countries and reasons.
  }
}
const countryWords = (path) =>
  (mix.get(path)?.top || []).map((c) => `${flagOf(c.country)} ${countryName(c.country)} ${c.share}%`.trim()).join(' · ')
const deadRows = dead.map((row) => {
  const top = mix.get(row.path)?.top[0]
  const reason = deadReason(records.get(row.path), {
    buys: Number(row.buys) || 0,
    country: top?.country || '',
    countryLabel: countryName(top?.country),
  })
  return {
    path: row.path,
    name: humanize(row.path, row.label),
    lost: row.lost,
    sub: `${num(row.entries)} arrived · ${num(row.clicks)} clicks out (${Math.round(row.rate * 1000) / 10}%)${countryWords(row.path) ? ` · ${countryWords(row.path)}` : ''}`,
    reason: reason ? reason.text : records.get(row.path) ? 'Platforms are listed and reachable: look at the page itself' : '',
  }
})
const countryRows = topTitles
  .filter((row) => mix.has(row.path))
  .map((row) => ({
    name: humanize(row.path, row.label),
    href: row.path,
    sub: countryWords(row.path),
    value: mix.get(row.path).total,
    unit: 'views',
  }))

// --- 1 day, 7 days, 30 days. The same lift the homepage planner uses for
// Rising this week, on every page with 30 opens this week, so a rise shows
// here before the planner acts on it. A big lift seen on only one or two
// days is more likely a bot burst than readers.
const baseDays = lifts.night ? baseDaysOf(lifts.historyStart, lifts.night) : 30
const lifted = lifts.rows
  .map((row) => ({ ...row, ...liftsOf(row, baseDays) }))
  .sort((a, b) => b.lift7 - a.lift7 || (a.path < b.path ? -1 : 1))
  .slice(0, 40)
const topLift = lifted[0]?.lift7 || 1
const liftRows = lifted.map((row) => ({
    name: humanize(row.path, row.label),
    href: row.path,
    sub: `${num(row.opens1)} yesterday · ${num(row.opens7)} in 7 days · ${num(row.opens30)} in ${baseDays} days · seen ${row.days7} of 7 days`,
    value: `${row.lift7.toFixed(1)}x`,
    bar: (row.lift7 / topLift) * 100,
    tone: row.days7 < 3 ? 'bad' : row.lift7 >= RISING.lift7 ? 'good' : undefined,
  }))

// The day-by-day line. A 7 or 30 day range ends with today, worked out from
// the totals this page already has; All time shows the last closed days.
const trend = range.mode === 'mixed' ? withToday(closedDays, totals, range.toDay, ['views', 'clicks']) : closedDays

const withRate = rows.map((row) => ({
  ...row,
  rate: handOff(row.clicks, row.views),
  avg: row.dwell_n ? row.dwell_sum / row.dwell_n : 0,
  quick_exits: quick.get(row.path) || 0,
}))

const best = withRate
  .filter((row) => (row.views || 0) >= FLOOR && row.clicks > 0)
  .sort((a, b) => b.rate - a.rate)
  .slice(0, 25)

const most = withRate.slice(0, 25)
const siteRate = handOff(totals.clicks, totals.views)

// All time keeps no per-page arrivals (only the daily tables do), so the
// entry questions are answered for the shorter ranges.
const hasEntries = range.mode !== 'all'

// --- Which pages bring people in
const entries = [...withRate]
  .filter((row) => (row.entries || 0) > 0)
  .sort((a, b) => b.entries - a.entries)
  .slice(0, 10)
const entryRows = entries.map((row) => ({
  name: humanize(row.path, row.label),
  href: row.path,
  sub: `${sectionName(row.page_type)} · ${row.rate}% click out`,
  value: row.entries,
  unit: 'arrived',
  tone: entryPageHint(row) ? 'bad' : 'blue',
}))
const entryWorst = entries.find((row) => entryPageHint(row))

// --- Which pages make people leave right away
const leavers = withRate
  .filter((row) => (row.entries || 0) >= MIN_ENTRIES)
  .map((row) => ({ ...row, share: Math.round(((row.quick_exits || 0) / row.entries) * 100) }))
  .sort((a, b) => b.share - a.share)
  .slice(0, 10)
const leaverRows = leavers.map((row) => ({
  name: humanize(row.path, row.label),
  href: row.path,
  sub: `${num(row.quick_exits)} of ${num(row.entries)} arrivals left at once`,
  value: `${row.share}%`,
  bar: row.share,
}))
const leaverWorst = leavers.find((row) => quickExitHint(row))

// --- Which answer pages work: /manhwa/solo-leveling/free is a "free" page.
const KINDS = { '': 'Title pages', free: 'Free to read', like: 'Similar titles', buy: 'Buy', characters: 'Characters' }
const TITLE_SECTIONS = new Set(['manhwa', 'manga', 'manhua', 'novel', 'anime', 'character'])
const byKind = new Map()
for (const row of withRate) {
  const parts = String(row.path || '').split('/').filter(Boolean)
  if (!TITLE_SECTIONS.has(parts[0]) || parts.length < 2) continue
  const kind = parts.length === 3 && KINDS[parts[2]] ? parts[2] : parts.length === 2 ? '' : null
  if (kind === null) continue
  const found = byKind.get(kind) || { views: 0, clicks: 0 }
  found.views += row.views || 0
  found.clicks += row.clicks || 0
  byKind.set(kind, found)
}
const answerBase = Object.keys(KINDS)
  .filter((kind) => byKind.has(kind))
  .map((kind) => {
    const row = byKind.get(kind)
    return {
      name: KINDS[kind],
      sub: `${num(row.views)} views · ${num(row.clicks)} clicks out`,
      value: `${handOff(row.clicks, row.views)}%`,
      rate: handOff(row.clicks, row.views),
    }
  })
const answerTop = Math.max(0, ...answerBase.map((row) => row.rate))
const answerRows = answerBase.map((row) => ({ ...row, bar: answerTop ? (row.rate / answerTop) * 100 : 0 }))

const bestTop = best[0]?.rate || 0
const bestRows = best.map((row) => ({
  name: humanize(row.path, row.label),
  href: row.path,
  sub: `${sectionName(row.page_type)} · ${num(row.views)} views · ${num(row.clicks)} clicks · ${fmtDwell(row.avg)}`,
  value: `${row.rate}%`,
  bar: bestTop ? (row.rate / bestTop) * 100 : 0,
  tone: 'good',
}))
const mostRows = most.map((row) => ({
  name: humanize(row.path, row.label),
  href: row.path,
  sub: [
    sectionName(row.page_type),
    hasEntries ? `${num(row.entries)} arrived first` : '',
    `${num(row.clicks)} clicks · ${row.rate}%`,
    fmtDwell(row.avg),
  ].filter(Boolean).join(' · '),
  value: row.views || 0,
  unit: 'views',
}))
const avgDwell = totals.dwell_n ? totals.dwell_sum / totals.dwell_n : 0

const edgeRows = edges.map((row) => ({
  name: `${sectionName(row.from_type)} → ${sectionName(row.to_type)}`,
  value: row.moves,
  unit: 'moves',
}))

const named = (row, hint) => hint && { ...hint, text: `${humanize(row.path, row.label)}: ${hint.text}` }
---


<Admin
  title="Pages"
  here="/my-admin/pages"
  range={range}
  signedIn={signedIn}
  secret={secret}
  wrongWord={wrongWord}
  note={`${range.label}. Which page hands readers on, and which only collects them.`}
>
  {signedIn && <WeekStrip db={db} fields={['views', 'clicks', 'reads', 'watches']} />}

  <section class="kpis" aria-label="All pages together">
    <Kpi label="Page views" value={totals.views || 0} spark={trend.map((d) => d.views)} hero />
    <Kpi label="Clicks out" value={totals.clicks || 0} spark={trend.map((d) => d.clicks)} tone="amber" />
    <Kpi label="Hand-off rate" value={`${siteRate}%`} />
    <Kpi label="Time on a page" value={fmtDwell(avgDwell)} />
  </section>

  {trend.length > 1 && (
    <div class="panel wide">
      <h2>Views and clicks out, day by day</h2>
      <p class="say">{range.mode === 'all' ? 'The last 60 closed days.' : 'Today is counted so far, so it looks low until tonight.'}</p>
      <Trend
        series={trend}
        lines={[
          { field: 'views', name: 'Page views', tone: 'blue' },
          { field: 'clicks', name: 'Clicks out', tone: 'amber' },
        ]}
        label="Page views and clicks out by day"
      />
    </div>
  )}

  <div class="panel">
    <h2>Which pages bring people in?</h2>
    <p class="say">The pages visits start on, and how many of their views end in a click out. A rose bar needs a better link.</p>
    {hasEntries ? (
      <BarList rows={entryRows} empty="No visits started in this window yet." />
    ) : (
      <p class="empty">All time keeps totals only. Pick 7 or 30 days to see where visits start.</p>
    )}
    <Hint hint={entryWorst && named(entryWorst, entryPageHint(entryWorst))} />
  </div>

  <div class="panel">
    <h2>Which pages make people leave right away?</h2>
    <p class="say">
      Of the visits that started on a page, the share that opened nothing else
      and clicked nothing. Pages with fewer than {MIN_ENTRIES} arrivals are left out.
    </p>
    {hasEntries ? (
      <BarList rows={leaverRows} tone="bad" empty={`No page has ${MIN_ENTRIES} arrivals in this window yet.`} />
    ) : (
      <p class="empty">Pick 7 or 30 days: this needs the arrivals, which All time does not keep.</p>
    )}
    <Hint hint={leaverWorst && named(leaverWorst, quickExitHint(leaverWorst))} />
  </div>

  <div class="panel wide">
    <h2>Which title pages are dead ends?</h2>
    <p class="say">
      Title pages with {DEAD_MIN_ENTRIES} or more arrivals, by the clicks out they lost: arrivals
      times how far their hand-off falls below the usual title page ({Math.round(usual * 1000) / 10}%).
      The line under each says why, from the page's own record and where its readers came from
      (last {COUNTRY_DAYS} days).
    </p>
    {range.mode === 'all' ? (
      <p class="empty">All time keeps no arrivals per page. Pick 7 or 30 days.</p>
    ) : deadRows.length === 0 ? (
      <p class="empty">No title page is losing readers in this window.</p>
    ) : (
      <ol class="why-list">
        {deadRows.map((row) => (
          <li>
            <div class="top"><a href={row.path}>{row.name}</a><b>{num(row.lost)} lost</b></div>
            <div class="sub">{row.sub}</div>
            {row.reason && <div class="reason">{row.reason}</div>}
          </li>
        ))}
      </ol>
    )}
  </div>

  <div class="panel">
    <h2>Which countries read which title?</h2>
    <p class="say">
      The busiest title pages in this window, with where their views came from over the last
      {COUNTRY_DAYS} days. A title read mostly in one country wants that country's platform first.
    </p>
    <BarList rows={countryRows} tone="violet" empty="No title page views in the last 7 days yet." />
  </div>

  <div class="panel">
    <h2>Which answer pages work?</h2>
    <p class="say">
      Every title has answer pages under it: free to read, similar titles, buy,
      characters. The number is clicks out for every 100 views.
    </p>
    <BarList rows={answerRows} tone="violet" empty="No title page views in this window yet." />
  </div>

  <div class="panel">
    <h2>How do people move around the site?</h2>
    <p class="say">"Arrived from outside" means the visit started there.</p>
    <BarList rows={edgeRows} empty="No moves yet." />
    <p class="more">
      <a href={withRange('/my-admin/journeys', range)}>Recent visits, step by step →</a>
      <a href={withRange('/my-admin/sections', range)}>Sections, countries and sources →</a>
    </p>
  </div>

  <div class="panel wide">
    <h2>1 day, 7 days, 30 days: what is rising?</h2>
    <p class="say">
      Pages with {RISING.minOpens7} or more opens in the last 7 closed days, by how
      much this week beats their usual week ({baseDays < 30 ? `the counter has ${baseDays} days so far` : 'the last 30 days'}).
      Green is {RISING.lift7}x or more, the Rising shelf's bar. Rose means seen on
      fewer than 3 of 7 days: more likely a burst than readers.
    </p>
    <BarList rows={liftRows} empty={`No page has ${RISING.minOpens7} opens in the last 7 days yet.`} />
  </div>

  <div class="panel">
    <h2>Best pages</h2>
    <p class="say">
      Ranked by hand-off: the share of views that ended in a read, watch or buy
      click. Pages under {FLOOR} views are left out, because a small number
      swings too much.
    </p>
    <BarList rows={bestRows} empty="Not enough clicks yet." />
  </div>

  <div class="panel">
    <h2>Most viewed</h2>
    <p class="say">The busiest pages. A busy page with a low hand-off is the best place to add a better link.</p>
    <BarList rows={mostRows} empty="Nothing yet." />
  </div>

  <p class="say">
    Time on page is measured on half of readers, and only when a page was on
    screen for 5 seconds or more. Treat it as a guide, not a stopwatch.
  </p>
</Admin>
