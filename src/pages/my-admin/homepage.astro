---
/**
 * Homepage. What the self-updating shelves show tonight, what they would
 * show next, what was kept off and why, and every change the planner made.
 *
 * The plan comes from the two files scripts/plan-home.mjs writes, bundled at
 * build time the way PopularNow.astro takes home-boost.json, so they are as
 * of the last deploy. The one live question is the last 7 days of
 * home_seen and home_click from daily_actions (plus the raw rows of today): how
 * often each shelf was seen and each slot opened.
 *
 * To act on it: pin or ban a title in data/home-rules.json and push. To take a
 * title off the site entirely, data/block.json as before.
 */
import WeekStrip from '../../components/admin/WeekStrip.astro'
import Admin from '../../layouts/Admin.astro'
import Hint from '../../components/admin/Hint.astro'
import BarList from '../../components/admin/BarList.astro'
import Kpi from '../../components/admin/Kpi.astro'
import { envOf } from '../../lib/runtime.js'
import { gate, rangeOf, num } from '../../lib/admin.js'
import { actionsFor } from '../../lib/admin-more.js'
import { SECTIONS, FLOORS, RISING, NEW, MONTH, daysBetween } from '../../lib/home-plan.mjs'
import { SEARCHING, SEARCH_MODES } from '../../lib/home-searching.mjs'
import { shelfNumbers } from '../../lib/home-sections.js'
import { planHealth } from '../../lib/admin-hints.js'
import { tomorrowOf, banLine } from '../../lib/home-preview.js'
import plan from '../../../data/home-auto.json'
import decisions from '../../../data/home-decisions.json'

export const prerender = false

const env = envOf(Astro)
const { db, secret, signedIn, wrongWord } = await gate(Astro, env)
if (secret && !signedIn && Astro.request.method !== 'POST') {
  return Astro.redirect('/my-admin')
}

// This week's shelf numbers, as the homepage itself reported them.
const week = rangeOf(new URL('?range=7d', Astro.url), '7d')
let acts = []
if (signedIn) acts = await actionsFor(db, week, ['home_seen', 'home_click'], 2000)
const live = shelfNumbers(acts)

// Hot this week ranks by volume until search arrivals have 28 days behind
// them, then by the rise. A plan made before the modes existed was a rise.
const searchMode = SEARCH_MODES[plan?.modes?.searching] ? plan.modes.searching : 'lift'
const searchNeeds = searchMode === 'volume'
  ? `Mode: ${SEARCH_MODES.volume}. Search arrivals have under ${SEARCHING.matureDays} days of history, so titles are ranked by how many people searched: ${SEARCHING.webPeople7} or more different people arriving from Google or another search engine this week, on ${SEARCHING.webDays7} or more days; or ${SEARCHING.sitePeople7} different people finding it with our own search on ${SEARCHING.siteDays7} days. It switches to "${SEARCH_MODES.lift}" by itself at ${SEARCHING.matureDays} days.`
  : `Mode: ${SEARCH_MODES.lift}. A title needs ${SEARCHING.webPeople7} different people arriving from Google or another search engine this week, on ${SEARCHING.webDays7} or more days, at ${SEARCHING.lift7} times its usual; or ${SEARCHING.sitePeople7} different people finding it with our own search on ${SEARCHING.siteDays7} days.`

// What a title needs, per shelf, in one line under its card.
const NEEDS = {
  rising: `A title needs ${FLOORS.people7} different people and ${RISING.minOpens7} opens this week at ${RISING.lift7} times its usual, on ${FLOORS.daysSeen7} or more days, and a clean name.`,
  saving: `A title needs ${FLOORS.savers7} different people saving it this week, on ${FLOORS.saveDays7} or more days, and a clean name.`,
  new: `A title first counted in the last ${NEW.firstSeenDays} days (or started on AniList in the last ${NEW.startDays}) needs ${NEW.minOpens7} opens by ${FLOORS.people7} people this week, and a clean name.`,
  searching: `${searchNeeds} Each line says both: search-engine people and arrivals, and people who searched here.`,
  month: `A title needs ${MONTH.minOpens30} opens by ${FLOORS.people30} people in 30 days, ${MONTH.minHandoff * 100} in 100 going on to read or watch, and a clean name.`,
}

const today = new Date().toISOString().slice(0, 10)
const log = Array.isArray(decisions) ? decisions : []
const health = planHealth(plan?.night, log, today)
const shortDate = (day) => new Date(`${day}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' })

// One card per section: its slots, with how long each has been up and how
// often it was opened from the homepage.
const cards = Object.entries(SECTIONS).map(([key, cfg]) => {
  const section = plan?.sections?.[key] || { enabled: false, items: [] }
  const items = section.items || []
  const rates = items.filter((it) => it.shown > 0).map((it) => it.opened / it.shown)
  const mid = rates.length ? [...rates].sort((a, b) => a - b)[Math.floor(rates.length / 2)] : 0
  const status = (it) =>
    it.pinned ? 'pinned' : it.nights <= 1 ? 'new' : it.nights >= cfg.maxStay ? 'leaving tomorrow' : 'kept'
  const seen = live.seen[key] || 0
  const clicked = live.shelfClicks[key] || 0
  const clicksOf = (id) => live.clicks.get(key + ':' + id) || 0
  const share = seen ? Math.round((clicked * 1000) / seen) / 10 : 0
  return {
    key,
    title: cfg.title,
    needs: NEEDS[key],
    week: seen
      ? `Seen ${num(seen)} times in the last 7 days, ${num(clicked)} covers opened (${share}%).`
      : 'Not seen on the homepage in the last 7 days.',
    state: section.enabled
      ? `Shown, ${items.length} titles.`
      : `Hidden: ${items.length} of ${cfg.floor} titles qualify.`,
    rows: items.map((it) => ({
      name: it.title || `#${it.id}`,
      href: it.path,
      sub: [
        status(it),
        `night ${it.nights}`,
        it.reason,
        seen ? `this week: opened ${clicksOf(it.id)} of ${seen} times seen` : '',
        it.shown ? `since added: opened ${it.opened} of ${it.shown} times shown` : '',
        it.shown && mid ? `${(it.opened / it.shown / mid).toFixed(1)}x the shelf median` : '',
      ].filter(Boolean).join(' · '),
      value: Math.round(it.score || 0),
      unit: 'score',
    })),
    next: (plan?.next?.[key] || []).map((it) => ({ name: it.title || `#${it.id}`, href: it.path, sub: it.reason, value: Math.round(it.score || 0), unit: 'score' })),
    rejected: (plan?.rejected?.[key] || []).map((it) => ({ name: it.title || `#${it.id}`, href: it.path || undefined, sub: it.reason, value: '' })),
  }
})

// The last 30 nights, newest first. A skipped night is drawn in the warning
// colour, with its reason, so a planner that stopped working is seen at once.
const oldest = log.length ? log[0].night : today
const recent = log.filter((d) => d && daysBetween(d.night, oldest) < 30)
const logRows = recent.map((d) => ({
  name: `${shortDate(d.night)} · ${d.section === 'all' ? 'all' : SECTIONS[d.section]?.title || d.section} · ${d.action}${d.title ? ` ${d.title}` : ''}`,
  href: d.path || undefined,
  sub: `${d.reason} (rule ${d.rule})`,
  value: '',
  tone: d.action === 'skip' ? 'bad' : undefined,
}))
// Tomorrow's homepage, as far as tonight's plan already decides it, with the
// line that bans any title from it (src/lib/home-preview.js).
const tomorrow = tomorrowOf(plan).map((s) => ({
  ...s,
  rows: [
    ...s.joins.map((t) => ({ name: t.title || `#${t.id}`, href: t.path, sub: `joins · ban: ${banLine(t.id)}`, value: '', tone: 'good' })),
    ...s.stays.map((t) => ({ name: t.title || `#${t.id}`, href: t.path, sub: `stays${t.badge ? ` · "${t.badge}"` : ''} · ban: ${banLine(t.id)}`, value: '' })),
    ...s.leaves.map((t) => ({ name: t.title || `#${t.id}`, href: t.path, sub: 'leaves: longest stay reached', value: '', tone: 'bad' })),
  ],
}))
const changes = log.filter((d) => d.night === plan?.night && ['add', 'drop', 'block'].includes(d.action)).length
---

<Admin
  title="Homepage"
  here="/my-admin/homepage"
  signedIn={signedIn}
  secret={secret}
  wrongWord={wrongWord}
  note="The shelves the homepage fills by itself each night. As of the last deploy."
>
  {signedIn && <WeekStrip db={db} fields={['views', 'visits', 'clicks']} />}

  <section class="kpis" aria-label="Homepage plan at a glance">
    <Kpi label="Plan made" value={plan?.night ? shortDate(plan.night) : 'Never'} unit={health.age != null ? `${health.age} nights ago` : ''} mood={health.hint ? 'bad' : 'good'} hero />
    <Kpi label="Changes that night" value={changes} />
    <Kpi label="Shelves shown" value={cards.filter((c) => plan?.sections?.[c.key]?.enabled).length} unit={`of ${cards.length}`} />
  </section>

  <div class="panel wide">
    <h2>Is the planner working?</h2>
    <p class="say">{health.line}</p>
    <Hint hint={health.hint} />
  </div>

  <div class="panel wide">
    <h2>Tomorrow's homepage, if the numbers hold</h2>
    <p class="say">
      What tonight's plan already decides for the next night: titles at their longest stay leave,
      and the first of "would be next" take the free slots, within the nightly limits. A title can
      still fall under a floor overnight. To keep one off, add its id to "ban" in data/home-rules.json
      (the line is under each title) and push.
    </p>
    {tomorrow.length === 0 && <p class="empty">No plan yet.</p>}
    {tomorrow.map((s) => (
      <>
        <h3>{s.title} · {s.enabledTomorrow ? 'shown' : 'hidden'}</h3>
        <BarList rows={s.rows} tone="good" empty="Empty." />
      </>
    ))}
  </div>

  {cards.map((card) => (
    <div class="panel wide">
      <h2>On the homepage tonight: {card.title}</h2>
      <p class="say">{card.state} {card.week} {card.needs}</p>
      <BarList rows={card.rows} tone="good" empty="No title qualifies yet." />
      <h3>Would be next</h3>
      <p class="say">Qualify, but got no slot tonight (the nightly limit or a full shelf).</p>
      <BarList rows={card.next} empty="Nobody waiting." />
      <h3>Kept off, and why</h3>
      <p class="say">The titles with the most saves that did not make it. Pin or ban in data/home-rules.json.</p>
      <BarList rows={card.rejected} tone="amber" empty="Nothing kept off." />
    </div>
  ))}

  <div class="panel wide">
    <h2>Decisions log</h2>
    <p class="say">Every change the planner made in the last 30 nights, newest first.</p>
    <BarList rows={logRows} empty="No decisions yet." />
  </div>
</Admin>
