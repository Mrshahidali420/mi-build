---
/**
 * Homepage. What the self-updating shelves show tonight, what they would
 * show next, what was kept off and why, and every change the planner made.
 *
 * The plan comes from the two files scripts/plan-home.mjs writes, bundled at
 * build time the way PopularNow.astro takes home-boost.json, so they are as
 * of the last deploy. The one live question is the last 7 days of
 * home_seen and home_click from daily_actions (plus the raw rows of today): how
 * often each shelf was seen and each slot opened.
 *
 * To act on it: the buttons under each title write a rule to D1
 * (src/lib/admin-actions.js), and the next night's planner run reads it. The
 * homepage is a prebuilt file, so a tap shows from tonight's update on.
 * data/home-rules.json still works for the same rules. To take a title off
 * the site entirely, data/block.json as before.
 */
import WeekStrip from '../../components/admin/WeekStrip.astro'
import Admin from '../../layouts/Admin.astro'
import Hint from '../../components/admin/Hint.astro'
import BarList from '../../components/admin/BarList.astro'
import Kpi from '../../components/admin/Kpi.astro'
import TapList from '../../components/admin/TapList.astro'
import { envOf } from '../../lib/runtime.js'
import { gate, rangeOf, num, ask } from '../../lib/admin.js'
import { RULES_LIST } from '../../lib/owner-rules.mjs'
import { actionsFor } from '../../lib/admin-more.js'
import { SECTIONS, FLOORS, RISING, NEW, MONTH, daysBetween } from '../../lib/home-plan.mjs'
import { SEARCHING, SEARCH_MODES } from '../../lib/home-searching.mjs'
import { shelfNumbers } from '../../lib/home-sections.js'
import { planHealth } from '../../lib/admin-hints.js'
import { tomorrowOf } from '../../lib/home-preview.js'
import plan from '../../../data/home-auto.json'
import fileRules from '../../../data/home-rules.json'
import decisions from '../../../data/home-decisions.json'

export const prerender = false

const env = envOf(Astro)
const { db, secret, signedIn, wrongWord } = await gate(Astro, env)
if (secret && !signedIn && Astro.request.method !== 'POST') {
  return Astro.redirect('/my-admin')
}

// This week's shelf numbers, as the homepage itself reported them.
const week = rangeOf(new URL('?range=7d', Astro.url), '7d')
let acts = []
let dbRules = []
if (signedIn) {
  ;[acts, dbRules] = await Promise.all([
    actionsFor(db, week, ['home_seen', 'home_click'], 2000),
    ask(db, RULES_LIST),
  ])
}
const live = shelfNumbers(acts)

// Every rule a title has, from the buttons (D1) or from data/home-rules.json.
// A button rule is the newer word and wins, except over a file ban: the
// planner lets a ban win from either place (mergeRules in
// src/lib/owner-rules.mjs), so the tab says the same. A file rule can only be
// named here, since undoing it means editing the file.
const ruleOf = new Map()
for (const ids of Object.values(fileRules.pin || {})) for (const id of ids) ruleOf.set(Number(id), { action: 'pin', source: 'file' })
for (const row of dbRules) ruleOf.set(Number(row.anilist_id), { action: row.action, source: 'db' })
for (const id of fileRules.ban || []) ruleOf.set(Number(id), { action: 'ban', source: 'file' })
const tap = (it, section) => ({ id: Number(it.id), name: it.title || `#${it.id}`, href: it.path || undefined, section, rule: ruleOf.get(Number(it.id)) })

// Tonight's people floors, scaled to the site's traffic by the planner
// (src/lib/home-floors.mjs). A plan made before they existed used the fixed ones.
const planFloors = plan?.floors?.sections || {}
const people = {
  people7: planFloors.rising ?? FLOORS.people7,
  savers7: planFloors.saving ?? FLOORS.savers7,
  people30: planFloors.month ?? FLOORS.people30,
  web: planFloors.searching ?? SEARCHING.webPeople7,
  site: plan?.floors?.site ?? SEARCHING.sitePeople7,
}
const opens = { ...{ rising: RISING.minOpens7, new: NEW.minOpens7, month: MONTH.minOpens30 }, ...(plan?.floors?.opens || {}) }
const grows = (n, ceiling) => (n < ceiling ? ` (grows with traffic, up to ${ceiling})` : '')
// The short line at the top of each card.
const needsPeople = (key) => {
  const n = { rising: people.people7, new: people.people7, saving: people.savers7, month: people.people30, searching: people.web }[key]
  return n == null ? '' : `Needs ${n} people, grows with traffic.`
}
const trafficNote = plan?.floors?.traffic
  ? `People floors tonight are set from ${num(plan.floors.traffic.people7)} people this week and ${num(plan.floors.traffic.people30)} this month (each day's people added up), never under 3.`
  : ''

// Hot this week ranks by volume until search arrivals have 28 days behind
// them, then by the rise. A plan made before the modes existed was a rise.
const searchMode = SEARCH_MODES[plan?.modes?.searching] ? plan.modes.searching : 'lift'
const searchNeeds = searchMode === 'volume'
  ? `Mode: ${SEARCH_MODES.volume}. Search arrivals have under ${SEARCHING.matureDays} days of history, so titles are ranked by how many people searched: ${people.web} or more different people${grows(people.web, SEARCHING.webPeople7)} arriving from Google or another search engine this week, on ${SEARCHING.webDays7} or more days; or ${people.site} different people finding it with our own search on ${SEARCHING.siteDays7} days. It switches to "${SEARCH_MODES.lift}" by itself at ${SEARCHING.matureDays} days.`
  : `Mode: ${SEARCH_MODES.lift}. A title needs ${people.web} different people${grows(people.web, SEARCHING.webPeople7)} arriving from Google or another search engine this week, on ${SEARCHING.webDays7} or more days, at ${SEARCHING.lift7} times its usual; or ${people.site} different people finding it with our own search on ${SEARCHING.siteDays7} days.`

// What a title needs, per shelf, in one line under its card.
const NEEDS = {
  rising: `A title needs ${people.people7} different people${grows(people.people7, FLOORS.people7)} and ${opens.rising} opens this week at ${RISING.lift7} times its usual, on ${FLOORS.daysSeen7} or more days, and a clean name.`,
  saving: `A title needs ${people.savers7} different people${grows(people.savers7, FLOORS.savers7)} saving it this week, on ${FLOORS.saveDays7} or more days, and a clean name.`,
  new: `A title first counted in the last ${NEW.firstSeenDays} days (or started on AniList in the last ${NEW.startDays}) needs ${opens.new} opens by ${people.people7} people${grows(people.people7, FLOORS.people7)} this week, and a clean name.`,
  searching: `${searchNeeds} Each line says both: search-engine people and arrivals, and people who searched here.`,
  month: `A title needs ${opens.month} opens by ${people.people30} people${grows(people.people30, FLOORS.people30)} in 30 days, ${MONTH.minHandoff * 100} in 100 going on to read or watch, and a clean name.`,
}

const today = new Date().toISOString().slice(0, 10)
const log = Array.isArray(decisions) ? decisions : []
const health = planHealth(plan?.night, log, today)
const shortDate = (day) => new Date(`${day}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' })

// One card per section: its slots, with how long each has been up and how
// often it was opened from the homepage.
const cards = Object.entries(SECTIONS).map(([key, cfg]) => {
  const section = plan?.sections?.[key] || { enabled: false, items: [] }
  const items = section.items || []
  const rates = items.filter((it) => it.shown > 0).map((it) => it.opened / it.shown)
  const mid = rates.length ? [...rates].sort((a, b) => a - b)[Math.floor(rates.length / 2)] : 0
  const status = (it) =>
    it.pinned ? 'pinned' : it.nights <= 1 ? 'new' : it.nights >= cfg.maxStay ? 'leaving tomorrow' : 'kept'
  const seen = live.seen[key] || 0
  const clicked = live.shelfClicks[key] || 0
  const clicksOf = (id) => live.clicks.get(key + ':' + id) || 0
  const share = seen ? Math.round((clicked * 1000) / seen) / 10 : 0
  return {
    key,
    title: cfg.title,
    needs: NEEDS[key],
    people: needsPeople(key),
    week: seen
      ? `Seen ${num(seen)} times in the last 7 days, ${num(clicked)} covers opened (${share}%).`
      : 'Not seen on the homepage in the last 7 days.',
    state: section.enabled
      ? `Shown, ${items.length} titles.`
      : `Hidden: ${items.length} of ${cfg.floor} titles qualify.`,
    rows: items.map((it) => ({
      ...tap(it, key),
      sub: [
        status(it),
        `night ${it.nights}`,
        it.reason,
        seen ? `this week: opened ${clicksOf(it.id)} of ${seen} times seen` : '',
        it.shown ? `since added: opened ${it.opened} of ${it.shown} times shown` : '',
        it.shown && mid ? `${(it.opened / it.shown / mid).toFixed(1)}x the shelf median` : '',
        `score ${Math.round(it.score || 0)}`,
      ].filter(Boolean).join(' · '),
      tone: 'good',
    })),
    next: (plan?.next?.[key] || []).map((it) => ({ ...tap(it, key), sub: `${it.reason} · score ${Math.round(it.score || 0)}` })),
    rejected: (plan?.rejected?.[key] || []).map((it) => ({ ...tap(it, key), sub: it.reason, tone: 'amber' })),
  }
})

// The last 30 nights, newest first. A skipped night is drawn in the warning
// colour, with its reason, so a planner that stopped working is seen at once.
const oldest = log.length ? log[0].night : today
const recent = log.filter((d) => d && daysBetween(d.night, oldest) < 30)
const logRows = recent.map((d) => ({
  name: `${shortDate(d.night)} · ${d.section === 'all' ? 'all' : SECTIONS[d.section]?.title || d.section} · ${d.action}${d.title ? ` ${d.title}` : ''}`,
  href: d.path || undefined,
  sub: `${d.reason} (rule ${d.rule})`,
  value: '',
  tone: d.action === 'skip' ? 'bad' : undefined,
}))
// Tomorrow's homepage, as far as tonight's plan already decides it
// (src/lib/home-preview.js), each title with its buttons.
const tomorrow = tomorrowOf(plan).map((s) => ({
  ...s,
  rows: [
    ...s.joins.map((t) => ({ ...tap(t, s.key), sub: 'joins', tone: 'good' })),
    ...s.stays.map((t) => ({ ...tap(t, s.key), sub: `stays${t.badge ? ` · "${t.badge}"` : ''}` })),
    ...s.leaves.map((t) => ({ ...tap(t, s.key), sub: 'leaves: longest stay reached', tone: 'bad' })),
  ],
}))

// The rules set with the buttons, newest first, each with Undo.
const when = (iso) => new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' })
const yourRules = dbRules.map((row) => ({
  id: Number(row.anilist_id),
  name: row.note || `AniList #${row.anilist_id}`,
  section: row.action === 'pin' ? row.section : '',
  sub: `${row.action === 'pin' ? `kept in ${SECTIONS[row.section]?.title || row.section}` : 'hidden from every shelf'} · set ${when(row.created_at)}`,
  rule: { action: row.action, source: 'db' },
}))
const fileCount = (fileRules.ban || []).length + Object.values(fileRules.pin || {}).reduce((n, ids) => n + ids.length, 0)
const changes = log.filter((d) => d.night === plan?.night && ['add', 'drop', 'block'].includes(d.action)).length
---

<Admin
  title="Homepage"
  here="/my-admin/homepage"
  signedIn={signedIn}
  secret={secret}
  wrongWord={wrongWord}
  note="The shelves the homepage fills by itself each night. As of the last deploy."
>
  {signedIn && <WeekStrip db={db} fields={['views', 'visits', 'clicks']} />}

  <section class="kpis" aria-label="Homepage plan at a glance">
    <Kpi label="Plan made" value={plan?.night ? shortDate(plan.night) : 'Never'} unit={health.age != null ? `${health.age} nights ago` : ''} mood={health.hint ? 'bad' : 'good'} hero />
    <Kpi label="Changes that night" value={changes} />
    <Kpi label="Shelves shown" value={cards.filter((c) => plan?.sections?.[c.key]?.enabled).length} unit={`of ${cards.length}`} />
  </section>

  <div class="panel wide">
    <h2>Is the planner working?</h2>
    <p class="say">{health.line}</p>
    {trafficNote && <p class="say">{trafficNote}</p>}
    <Hint hint={health.hint} />
  </div>

  <div class="panel wide">
    <h2>Your rules</h2>
    <p class="say">
      Set with the buttons on this page, newest first. A change applies at tonight's update,
      when the homepage is planned and rebuilt.
      {fileCount > 0 && ` ${fileCount} more ${fileCount === 1 ? 'rule is' : 'rules are'} set in data/home-rules.json.`}
    </p>
    <TapList rows={yourRules} empty="No rules yet. Use the buttons under any title below." />
  </div>

  <div class="panel wide">
    <h2>Tomorrow's homepage, if the numbers hold</h2>
    <p class="say">
      What tonight's plan already decides for the next night: titles at their longest stay leave,
      and the first of "would be next" take the free slots, within the nightly limits. A title can
      still fall under a floor overnight. "Hide from homepage" keeps a title off every shelf;
      "Keep on homepage" holds it in that shelf while it passes the adult filter. Both apply at
      tonight's update.
    </p>
    {tomorrow.length === 0 && <p class="empty">No plan yet.</p>}
    {tomorrow.map((s) => (
      <>
        <h3>{s.title} · {s.enabledTomorrow ? 'shown' : 'hidden'}</h3>
        <TapList rows={s.rows} empty="Empty." />
      </>
    ))}
  </div>

  {cards.map((card) => (
    <div class="panel wide">
      <h2>On the homepage tonight: {card.title}</h2>
      <p class="say"><strong>{card.people}</strong> {card.state} {card.week} {card.needs}</p>
      <TapList rows={card.rows} empty="No title qualifies yet." />
      <h3>Would be next</h3>
      <p class="say">Qualify, but got no slot tonight (the nightly limit or a full shelf).</p>
      <TapList rows={card.next} empty="Nobody waiting." />
      <h3>Kept off, and why</h3>
      <p class="say">The titles with the most saves that did not make it. "Keep on homepage" asks for one anyway; an adult or blocked title is still refused.</p>
      <TapList rows={card.rejected} empty="Nothing kept off." />
    </div>
  ))}

  <div class="panel wide">
    <h2>Decisions log</h2>
    <p class="say">Every change the planner made in the last 30 nights, newest first.</p>
    <BarList rows={logRows} empty="No decisions yet." />
  </div>
</Admin>
